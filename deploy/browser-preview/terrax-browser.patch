index 0000000..0943fab
--- /dev/null
+++ b/src/lib/crs.ts
@@ -0,0 +1,46 @@
+// Any projected CRS a GeoTIFF declares (EPSG code or its own parameters), via its geokeys → a Proj4 definition
+// (geotiff-geokeys-to-proj4, which carries the EPSG parameters) → proj4js. WGS84, Web Mercator and WGS84 UTM keep
+// their exact built-in formulas; this is used only for the others.
+import proj4 from 'proj4';
+import { toProj4, type GeoKeys } from 'geotiff-geokeys-to-proj4';
+
+export interface CustomCrs {
+  /** Proj4 definition of the file's CRS. */
+  proj4: string;
+  /** Multipliers from the file's coordinates to the units Proj4 expects (for example feet to metres). */
+  mx: number;
+  my: number;
+  label: string;
+}
+
+/** The CRS of a GeoTIFF's geokeys, or null when it has none or it cannot be converted. */
+export function crsFromGeoKeys(keys: Record<string, unknown> | null, epsg: number | null): CustomCrs | null {
+  if (!keys) return null;
+  try {
+    const r = toProj4(keys as GeoKeys);
+    if (!r.proj4 || r.isGCS) return null;
+    // Check the definition works before trusting it.
+    proj4('WGS84', r.proj4).forward([0, 0]);
+    return { proj4: r.proj4, mx: r.conversionParameters.x || 1, my: r.conversionParameters.y || 1, label: epsg ? `EPSG:${epsg}` : 'custom CRS' };
+  } catch {
+    return null;
+  }
+}
+
+/** WGS84 longitude/latitude → the file's coordinates. */
+export function crsForward(c: CustomCrs): (lon: number, lat: number) => [number, number] {
+  const t = proj4('WGS84', c.proj4);
+  return (lon, lat) => {
+    const [x, y] = t.forward([lon, lat]);
+    return [x / c.mx, y / c.my];
+  };
+}
+
+/** The file's coordinates → WGS84 longitude/latitude. */
+export function crsInverse(c: CustomCrs): (x: number, y: number) => [number, number] {
+  const t = proj4('WGS84', c.proj4);
+  return (x, y) => {
+    const [lon, lat] = t.inverse([x * c.mx, y * c.my]);
+    return [lon, lat];
+  };
+}
