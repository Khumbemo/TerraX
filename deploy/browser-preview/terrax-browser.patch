+    area += cellHa[k];
+    if (c >= 0.5) { // below half a metre of mean canopy height a block holds no tree biomass
+      const l = Math.log(c);
+      est[k] = corr * Math.exp(f.b0 + f.b1 * l);
+      total += est[k] * cellHa[k];
+      lx.push(l);
+      lha.push(cellHa[k]);
+      if (c < tmin || c > tmax) outside += cellHa[k];
+    }
+  }
+  // Cholesky of the parameter covariance s²·(XᵀX)⁻¹.
+  const [i00, i01, i11] = f.inv;
+  const l00 = Math.sqrt(s2 * i00), l10 = (s2 * i01) / l00, l11 = Math.sqrt(Math.max(s2 * i11 - l10 * l10, 0));
