@@ -0,0 +1,125 @@
+// Map accuracy and area estimation from a stratified random sample (Olofsson et al. 2014, Remote Sensing of
+// Environment 148: 42–57). With W_i the mapped area share of class i, n_ij the sample count of map class i with
+// reference class j and n_i· the stratum's sample size, the area proportions are p̂_ij = W_i n_ij / n_i· (eq. 4);
+// overall, user's and producer's accuracy and the area of each reference class follow, with standard errors
+// from eqs. 5–7 and 10. The area estimates correct the map's own pixel counts for its errors.
+import { rng } from './kmeans';
+
+const Z95 = 1.959964;
+
+/** At least nMin points per mapped class (or the whole class if smaller), the rest proportional to area; sums to nTotal. */
+export function allocate(areas: number[], nTotal: number, nMin = 50): number[] {
+  const base = areas.map(a => (a > 0 ? nMin : 0));
+  const rest = Math.max(0, nTotal - base.reduce((x, y) => x + y, 0));
+  const sum = areas.reduce((x, y) => x + y, 0);
+  const share = areas.map(a => (sum > 0 ? a / sum : 0));
+  const extra = share.map(s => Math.floor(s * rest));
+  let left = rest - extra.reduce((x, y) => x + y, 0);
+  // Largest remainders take the leftover points.
+  const order = share.map((s, i) => [s * rest - extra[i], i] as const).sort((a, b) => b[0] - a[0] || a[1] - b[1]);
+  for (const [, i] of order) {
+    if (left <= 0) break;
+    extra[i]++;
+    left--;
+  }
+  return base.map((b, i) => b + extra[i]);
+}
+
+/** Cell indices drawn at random without replacement within each class id (1-based) of the class map. */
+export function stratifiedSample(classes: Uint8Array, ids: number[], sizes: number[], seed = 11): { cell: number; cls: number }[] {
+  const rand = rng(seed);
+  const out: { cell: number; cls: number }[] = [];
+  ids.forEach((id, i) => {
+    const cells: number[] = [];
+    for (let k = 0; k < classes.length; k++) if (classes[k] === id) cells.push(k);
+    const m = Math.min(sizes[i], cells.length);
+    for (let j = 0; j < m; j++) {
+      const p = j + Math.floor(rand() * (cells.length - j)); // partial Fisher–Yates
+      [cells[j], cells[p]] = [cells[p], cells[j]];
+      out.push({ cell: cells[j], cls: id });
+    }
+  });
+  return out;
+}
+
+export interface AccuracyClass {
+  label: string;
+  samples: number;
+  mappedArea: number;
+  userAccuracy: number | null;
+  userCi: number | null;
+  producerAccuracy: number | null;
+  producerCi: number | null;
+  area: number;
+  areaCi: number | null;
+}
+
+export interface Accuracy {
+  labels: string[];
+  counts: number[][];
+  samples: number;
+  totalArea: number;
+  overallAccuracy: number;
+  overallCi: number | null;
+  classes: AccuracyClass[];
+  unsampled: string[];
+}
+
+/** counts[i][j]: sample points of map class i with reference class j; mappedArea[i]: area of map class i. */
+export function assess(counts: number[][], mappedArea: number[], labels: string[]): Accuracy {
+  const k = counts.length;
+  const total = mappedArea.reduce((a, b) => a + b, 0);
+  if (!(total > 0)) throw new Error('The map has no area.');
+  const w = mappedArea.map(a => a / total);
+  const ni = counts.map(r => r.reduce((a, b) => a + b, 0));
+  const frac = counts.map((r, i) => r.map(v => (ni[i] ? v / ni[i] : 0)));
+  const p = frac.map((r, i) => r.map(v => w[i] * v));
+  const pRef = Array.from({ length: k }, (_, j) => p.reduce((s, r) => s + r[j], 0));
+  const pMap = p.map(r => r.reduce((a, b) => a + b, 0));
+  const diag = p.map((r, i) => r[i]);
+  const oa = diag.reduce((a, b) => a + b, 0);
+  const denom = ni.map(v => (v > 1 ? v - 1 : NaN));
+  const ua = pMap.map((m, i) => (m > 0 ? diag[i] / m : NaN));
+  const pa = pRef.map((m, j) => (m > 0 ? diag[j] / m : NaN));
+  const vUa = ua.map((u, i) => (u * (1 - u)) / denom[i]);
+  let vOa = 0;
+  for (let i = 0; i < k; i++) if (Number.isFinite(vUa[i])) vOa += w[i] ** 2 * vUa[i];
+  const vRef = Array.from({ length: k }, (_, j) => {
+    let s = 0;
+    for (let i = 0; i < k; i++) if (Number.isFinite(denom[i])) s += (w[i] ** 2 * frac[i][j] * (1 - frac[i][j])) / denom[i];
+    return s;
+  });
+  const nRef = Array.from({ length: k }, (_, j) => mappedArea.reduce((s, a, i) => s + a * frac[i][j], 0));
+  const vPa = Array.from({ length: k }, (_, j) => {
+    if (!(nRef[j] > 0) || !Number.isFinite(pa[j])) return NaN;
+    const own = Number.isFinite(ua[j]) && Number.isFinite(denom[j]) ? (mappedArea[j] ** 2 * (1 - pa[j]) ** 2 * ua[j] * (1 - ua[j])) / denom[j] : 0;
+    let others = 0;
+    for (let i = 0; i < k; i++) if (i !== j && Number.isFinite(denom[i])) others += (mappedArea[i] ** 2 * frac[i][j] * (1 - frac[i][j])) / denom[i];
+    return (own + pa[j] ** 2 * others) / nRef[j] ** 2;
+  });
+  const ci = (v: number) => (Number.isFinite(v) ? Z95 * Math.sqrt(Math.max(0, v)) : null);
+  const fin = (v: number) => (Number.isFinite(v) ? v : null);
+  return {
+    labels, counts, samples: ni.reduce((a, b) => a + b, 0), totalArea: total, overallAccuracy: oa, overallCi: ci(vOa),
+    classes: labels.map((label, j) => {
+      const s = ci(vRef[j]);
+      return { label, samples: ni[j], mappedArea: mappedArea[j], userAccuracy: fin(ua[j]), userCi: ci(vUa[j]), producerAccuracy: fin(pa[j]), producerCi: ci(vPa[j]), area: pRef[j] * total, areaCi: s === null ? null : s * total };
+    }),
+    unsampled: labels.filter((_, i) => !ni[i] && mappedArea[i] > 0),
+  };
+}
+
+export function accuracyMarkdown(a: Accuracy, unit: string, missing: number): string {
+  const f = (v: number) => (Math.abs(v) >= 1000 ? Math.round(v).toLocaleString('en') : v.toPrecision(4));
+  const pct = (v: number | null, c: number | null) => (v === null ? '—' : `${(v * 100).toFixed(1)} %${c === null ? '' : ` ± ${(c * 100).toFixed(1)}`}`);
+  return [
+    '', '## Accuracy and area (stratified sample)', '',
+    `- ${a.samples} reference points${missing ? ` (${missing} unlabelled points were left out)` : ''}; overall accuracy ${pct(a.overallAccuracy, a.overallCi)} (95 % CI).`, '',
+    `| Class | Mapped (${unit}) | Estimated area (${unit}, 95 % CI) | User’s accuracy | Producer’s accuracy | Points |`, '|---|---|---|---|---|---|',
+    ...a.classes.map(c => `| ${c.label} | ${f(c.mappedArea)} | ${f(c.area)}${c.areaCi === null ? '' : ` ± ${f(c.areaCi)}`} | ${pct(c.userAccuracy, c.userCi)} | ${pct(c.producerAccuracy, c.producerCi)} | ${c.samples} |`),
+    '', 'Error matrix of sample counts (rows: map, columns: reference):', '', `| | ${a.labels.join(' | ')} |`, `${'|---'.repeat(a.labels.length + 1)}|`,
+    ...a.counts.map((r, i) => `| **${a.labels[i]}** | ${r.join(' | ')} |`), '',
+    '- Method: Olofsson et al. (2014) stratified estimators: cell proportions p̂ᵢⱼ = Wᵢ nᵢⱼ / nᵢ· weight each stratum by its mapped area, so the estimated areas correct the map’s own pixel counts for its errors. Report these estimates with their confidence intervals rather than the mapped areas.',
+    ...(a.unsampled.length ? [`- No sample points in: ${a.unsampled.join(', ')}; their accuracy and area cannot be estimated.`] : []),
+  ].join('\n');
+}
