+}
+
+/** Cells whose centres lie inside a plot (rasterio's geometry_mask without all_touched, as on the server). */
+export function plotCells(g: Polygon | MultiPolygon, grid: PlotGrid): number[] {
+  const polys = projectRings(g, grid);
+  const [x0, y0, x1, y1] = grid.bbox;
+  const cw = (x1 - x0) / grid.width, ch = (y1 - y0) / grid.height;
+  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
+  for (const poly of polys) for (const [x, y] of poly[0]) (minX = Math.min(minX, x)), (maxX = Math.max(maxX, x)), (minY = Math.min(minY, y)), (maxY = Math.max(maxY, y));
