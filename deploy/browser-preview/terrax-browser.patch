+ * Above-ground biomass from top-of-canopy height, calibrated on field plots: AGB = a·TCHᵇ (Asner & Mascaro 2014),
+ * least squares on ln AGB = ln a + b ln TCH, back-transformed with Baskerville's (1972) correction exp(σ²/2), applied
+ * to blocks of about plot size. The total's 95 % interval is by Monte Carlo: (ln a, b) from their sampling
+ * distribution (bivariate t with n − 2 degrees of freedom, covariance σ̂²(XᵀX)⁻¹) and an independent log-scale
+ * residual per block, so spatial correlation is ignored and the interval is a lower bound of the true one.
+ */
+export function biomassModel(tch: number[], agb: number[], cellsTch: Float64Array, cellHa: Float64Array, draws = 2000, seed = 17): Biomass {
+  const use = tch.map((t, i) => Number.isFinite(t) && Number.isFinite(agb[i]) && t > 0 && agb[i] > 0);
