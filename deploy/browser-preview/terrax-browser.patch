+  assert.equal(nativeZoom(30, 0), 13);
+  assert.equal(nativeZoom(10, 60), 13);
+});
+
+test('tiles reproduce a UTM class grid cell for cell, through the file CRS', () => {
+  // 3,000 × 2,000 cells of 10 m in UTM 46N, one-cell stripes: far finer than a 1,024 px picture.
+  const w = 3000, h = 2000, x0 = 500000, y1 = 3000000;
+  const rgba = new Uint8ClampedArray(w * h * 4);
+  for (let r = 0; r < h; r++) for (let c = 0; c < w; c++) rgba.set([c % 2 ? 255 : 0, Math.floor(r / 50) % 2 ? 255 : 0, 0, r < 100 && c < 100 ? 0 : 255], (r * w + c) * 4);
+  const meta = { geographic: false, epsg: 32646, bbox: [x0, y1 - h * 10, x0 + w * 10, y1] } as GeoMeta;
+  const [s, west] = utmToLatLon(x0, y1 - h * 10, 46, false), [n, east] = utmToLatLon(x0 + w * 10, y1, 46, false);
+  const id = registerTileGrid({ rgba, width: w, height: h, toGrid: gridMapping(w, h, [[s, west], [n, east]], meta) });
+  const [clat, clon] = utmToLatLon(x0 + 15000, y1 - 10000, 46, false);
+  const z = 17;
+  const [tx, ty] = tileOf(clon, clat, z);
+  const out = renderTile(id, z, tx, ty);
+  assert.ok(out);
+  let same = 0;
+  const world = 256 * 2 ** z;
+  for (let py = 0; py < 256; py++) {
+    const lat = (Math.atan(Math.sinh(Math.PI * (1 - (2 * (ty * 256 + py + 0.5)) / world))) * 180) / Math.PI;
+    for (let px = 0; px < 256; px++) {
+      const lon = ((tx * 256 + px + 0.5) / world) * 360 - 180;
+      const u = latLonToUtm(lat, lon, 46);
+      const c = Math.floor((u.easting - x0) / 10), r = Math.floor((y1 - u.northing) / 10);
+      const k = (py * 256 + px) * 4;
+      if (out[k] === (c % 2 ? 255 : 0) && out[k + 1] === (Math.floor(r / 50) % 2 ? 255 : 0)) same++;
+    }
+  }
+  assert.ok(same / 65536 > 0.99, `${same} of 65,536 pixels match`);
+  // The transparent corner gives no tile; far away there is none either.
+  const [alat, alon] = utmToLatLon(x0 + 300, y1 - 300, 46, false);
+  const [cx, cy] = tileOf(alon, alat, 19);
+  assert.equal(renderTile(id, 19, cx, cy), null);
+  assert.equal(renderTile(id, 17, 0, 0), null);
+  assert.equal(renderTile(9999, 17, tx, ty), null);
+});
