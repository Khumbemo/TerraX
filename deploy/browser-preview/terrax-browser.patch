@@ -0,0 +1,286 @@
+import { useState } from 'react';
+import type { Feature, FeatureCollection, Point } from 'geojson';
+import { downloadText } from '../../lib/download';
+import { bboxToLatLng } from '../../lib/geo';
+import { mapImage } from '../../lib/overlay';
+import { unprojector } from '../../lib/patches';
+import { groundGeometry, openGeoTiff, sameGrid, type GeoMeta } from '../../lib/rasterio';
+import { fetchSample } from '../../lib/samples';
+import { fmt } from '../../lib/stats';
+import { useToast } from '../../lib/toast';
+import type { ToolOutput } from '../../lib/tools/registry';
+import { analyzeCanopy, canopyMarkdown, chmFromLas, type CanopyResult } from '../../lib/tools/canopy';
+import FileDrop from '../FileDrop';
+import RgbaCanvas from '../RgbaCanvas';
+import { Stat } from './ForestLossTool';
+
+interface Props {
+  onOutput: (out: ToolOutput | null) => void;
+}
+
+type Source = 'cloud' | 'dsm' | 'chm';
+const COLORS: [number, number, number][] = [[247, 252, 245], [199, 233, 192], [116, 196, 118], [35, 139, 69], [0, 68, 27]];
+const MAP_TREES = 20_000;
+
+interface Done {
+  name: string;
+  source: string;
+  chm: Float32Array;
+  width: number;
+  height: number;
+  res: CanopyResult;
+  notes: string[];
+  hi: number;
+  trees: FeatureCollection<Point> | null;
+}
+
+function chmRgba(chm: Float32Array, hi: number): Uint8ClampedArray {
+  const out = new Uint8ClampedArray(chm.length * 4);
+  for (let k = 0; k < chm.length; k++) {
+    const v = chm[k];
+    if (Number.isNaN(v)) continue;
+    const x = Math.min(1, Math.max(0, v / (hi || 1))) * (COLORS.length - 1);
+    const i = Math.min(COLORS.length - 2, Math.floor(x)), f = x - i;
+    out.set([0, 1, 2].map(c => COLORS[i][c] + (COLORS[i + 1][c] - COLORS[i][c]) * f).concat(255), k * 4);
+  }
+  return out;
+}
+
+export default function CanopyTool({ onOutput }: Props) {
+  const notify = useToast();
+  const [source, setSource] = useState<Source>('cloud');
+  const [files, setFiles] = useState<Partial<Record<'cloud' | 'dsm' | 'dtm' | 'chm', File>>>({});
+  const [cell, setCell] = useState('1');
+  const [threshold, setThreshold] = useState('2');
+  const [minTree, setMinTree] = useState('5');
+  const [busy, setBusy] = useState(false);
+  const [done, setDone] = useState<Done | null>(null);
+  const fail = (m: string) => notify(m, 'error');
+
+  const run = async (src = source, fs = files) => {
+    const thr = Number(threshold), mt = Number(minTree), cs = Number(cell);
+    if (![thr, mt, cs].every(v => Number.isFinite(v) && v > 0)) return fail('Cell size and heights must be positive numbers of metres.');
+    setBusy(true);
+    try {
+      let chm: Float32Array, w: number, h: number, cellM: number, cellArea: (row: number) => number, name: string, sourceText: string;
+      const notes: string[] = [];
+      let toLonLat: ((col: number, row: number) => [number, number]) | null = null;
+      let bounds: ReturnType<typeof bboxToLatLng> = null;
+      let gridMeta: GeoMeta | null = null; // places the full-resolution map tiles
+      if (src === 'cloud') {
+        const f = fs.cloud;
+        if (!f) throw new Error('Add a LAS or LAZ point cloud first.');
+        const g = await chmFromLas(await f.arrayBuffer(), cs);
+        ({ chm, width: w, height: h } = g);
+        cellM = cs;
+        cellArea = () => cs * cs;
+        name = f.name;
+        sourceText = `${g.points.toLocaleString()} points, ${g.ground.toLocaleString()} ground (class 2), gridded at ${fmt(cs, 3)} m`;
+        notes.push(...g.notes);
