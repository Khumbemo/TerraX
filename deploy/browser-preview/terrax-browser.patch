+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, readFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { expect, test } from '@playwright/test';
+import { openTool, start } from './helpers';
+
+// A 1,500 × 1,200 NDVI pair (30 m, UTM 46N) is wider than the 1,024 px map picture, so zooming in switches the
+// map to full-resolution tiles drawn in the tab from the class grid.
+test('forest change wider than the picture is drawn as full-resolution tiles when zoomed in', async ({ page }) => {
+  const errors = await start(page);
+  const dir = mkdtempSync(join(tmpdir(), 'terrax-tiles-'));
+  const paths = ['a', 'b'].map(n => join(dir, `ndvi_${n}.tif`));
+  execFileSync('python3', ['-c', `
+import numpy as np, rasterio
+from rasterio.transform import from_origin
+for k, path in enumerate(${JSON.stringify(paths)}):
+    v = np.full((1200, 1500), 0.8, np.float32)
+    if k:
+        v[400:800, 500:1100] = 0.2  # a 12 km × 12 km clearing
+    with rasterio.open(path, 'w', driver='GTiff', width=1500, height=1200, count=1, dtype='float32', crs='EPSG:32646', transform=from_origin(600000, 2860000, 30, 30)) as d:
+        d.write(v, 1)
+`]);
+  await openTool(page, 'Forest loss');
+  await page.setInputFiles('#forest-a', { name: 'ndvi_a.tif', mimeType: 'image/tiff', buffer: readFileSync(paths[0]) });
+  await page.setInputFiles('#forest-b', { name: 'ndvi_b.tif', mimeType: 'image/tiff', buffer: readFileSync(paths[1]) });
+  await page.click('button:has-text("Estimate forest loss")');
+  await expect(page.locator('.stat', { hasText: 'Forest loss' })).toContainText('ha');
+  await expect(page.locator('.leaflet-overlay-pane img.pixelated-overlay')).toBeAttached();
+  for (let i = 0; i < 4; i++) await page.click('.leaflet-control-zoom-in'), await page.waitForTimeout(400);
+  // Painted tiles: some tile canvas holds opaque pixels of the class map; the picture has handed over.
+  await expect
+    .poll(() =>
+      page.evaluate(() =>
+        [...document.querySelectorAll<HTMLCanvasElement>('canvas[data-result="tile"]')].some(c => {
+          const d = c.getContext('2d')!.getImageData(0, 0, c.width, c.height).data;
+          for (let i = 3; i < d.length; i += 4) if (d[i]) return true;
+          return false;
+        }),
+      ),
+    )
+    .toBe(true);
+  await expect(page.locator('.leaflet-overlay-pane img.pixelated-overlay')).toHaveCount(0);
+  expect(errors).toEqual([]);
+});
