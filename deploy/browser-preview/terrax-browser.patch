+import { fitBreaks, MIN_DATES } from '../src/lib/breaks';
+
+interface Fixture { t: number[]; minDrop: number; values: (number | null)[][]; after: number[]; before: number[]; shift: (number | null)[]; valid: number[] }
+
+test('per-pixel break fit gives the Python server’s dates and shifts (8 dates, 3,000 pixels, 15 % clouds)', () => {
+  const f = JSON.parse(readFileSync(new URL('./fixtures/breaks_parity.json', import.meta.url), 'utf8')) as Fixture;
+  const values = f.values.map(row => Float32Array.from(row, v => (v === null ? NaN : v)));
+  const r = fitBreaks(f.t, values, f.minDrop);
+  assert.deepEqual(Array.from(r.valid), f.valid);
+  assert.deepEqual(Array.from(r.after), f.after);
+  assert.deepEqual(Array.from(r.before), f.before);
+  f.shift.forEach((c, p) => (c === null ? assert.ok(Number.isNaN(r.shift[p])) : assert.ok(Math.abs(r.shift[p] - c) < 1e-6, `pixel ${p}: ${r.shift[p]} vs ${c}`)));
+  assert.ok(f.after.filter(a => a >= 0).length > 500);
+});
+
+test('a clean drop is dated by the clear dates around it; a trend alone and too few dates are not', () => {
+  const t = [2018, 2019, 2020, 2021, 2022, 2023];
+  const col = (vals: number[]) => vals.map(v => Float32Array.of(v));
+  const drop = fitBreaks(t, col([0.8, 0.81, 0.8, 0.4, 0.41, 0.4]), 0.15);
+  assert.equal(drop.after[0], 3);
+  assert.equal(drop.before[0], 2);
+  assert.ok(Math.abs(drop.shift[0] + 0.4) < 0.02);
+  // A cloudy date next to the drop widens the interval: after the last clear date before it, by the first after.
+  const cloudy = fitBreaks([...t, 2024], col([0.8, 0.81, 0.8, NaN, 0.41, 0.4, 0.4]), 0.15);
+  assert.deepEqual([cloudy.before[0], cloudy.after[0]], [2, 4]);
+  assert.equal(fitBreaks(t, col([0.8, 0.75, 0.7, 0.65, 0.6, 0.55]), 0.15).after[0], -1); // steady decline: no break
