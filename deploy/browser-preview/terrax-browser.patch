+    }
+    if (g.type !== 'Polygon' && g.type !== 'MultiPolygon') return;
+    try {
+      const { mask } = boundaryMask(raster.meta, grids[0], { name: label, areaM2: 0, geojson: { type: 'FeatureCollection', features: [{ type: 'Feature', properties: {}, geometry: g }] } });
+      for (let i = 0; i < n; i++) if (mask[i]) (code[i] = c), (group[i] = si + 1);
+    } catch {
+      // a shape that misses the image adds no pixels; classes left without pixels are reported below
+    }
+  });
+  const byClass: number[][] = Array.from({ length: k }, () => []);
+  for (let i = 0; i < n; i++) if (code[i] && isValid(i)) byClass[code[i] - 1].push(i);
+  const missing = labels.filter((_, c) => !byClass[c].length);
+  if (missing.length) throw new Error(`No valid pixels fall inside the training shapes for: ${missing.join(', ')}. Check that the shapes lie on the image.`);
+  const underShapes = byClass.reduce((a, b) => a + b.length, 0);
+  const maxPerClass = opts.maxPerClass ?? 2000, trees = opts.trees ?? 50, seed = opts.seed ?? 7;
+  const rand = rng(seed + 202);
+  const picked: number[] = [];
+  for (const cells of byClass) {
+    const a = cells.slice();
+    const m = Math.min(maxPerClass, a.length);
+    for (let j = 0; j < m; j++) {
+      const p = j + Math.floor(rand() * (a.length - j));
+      [a[j], a[p]] = [a[p], a[j]];
+    }
+    picked.push(...a.slice(0, m));
+  }
+  picked.sort((a, b) => a - b);
+  const X = new Float64Array(picked.length * d), y = new Int32Array(picked.length), groups = new Int32Array(picked.length);
+  picked.forEach((i, r) => {
+    for (let a = 0; a < d; a++) X[r * d + a] = grids[a].data[i];
+    y[r] = code[i] - 1;
+    groups[r] = group[i];
+  });
+  const valid: number[] = [];
+  for (let i = 0; i < n; i++) if (isValid(i)) valid.push(i);
+  const Q = new Float32Array(valid.length * d);
+  valid.forEach((i, r) => {
+    for (let a = 0; a < d; a++) Q[r * d + a] = grids[a].data[i];
+  });
+  const out = await forestAsync({ X, y, groups, d, k, Q, trees, seed });
+  const classes = new Uint8Array(n);
+  valid.forEach((i, r) => (classes[i] = out.pred[r] + 1));
+
+  const geo = groundGeometry(raster.meta, grids[0]);
+  const px = new Float64Array(k), m2 = new Float64Array(k), sums = Array.from({ length: k }, () => new Float64Array(d));
+  const redIdx = opts.roles.red !== undefined ? bands.indexOf(opts.roles.red) : -1;
+  const nirIdx = opts.roles.nir !== undefined ? bands.indexOf(opts.roles.nir) : -1;
+  const ndviSum = new Float64Array(k), ndviN = new Float64Array(k);
+  for (const i of valid) {
+    const j = classes[i] - 1;
+    px[j]++;
+    if (geo) m2[j] += geo.cellArea(Math.floor(i / width));
+    for (let a = 0; a < d; a++) sums[j][a] += grids[a].data[i];
+    if (redIdx >= 0 && nirIdx >= 0) {
+      const r = grids[redIdx].data[i], nr = grids[nirIdx].data[i];
+      if (r + nr !== 0) (ndviSum[j] += (nr - r) / (nr + r)), ndviN[j]++;
+    }
+  }
+  const stats: LandCoverClass[] = labels.map((_, j) => ({
+    id: j + 1, pixels: px[j], ha: geo ? m2[j] / 10_000 : null, share: px[j] / (valid.length || 1),
+    bandMeans: Array.from(sums[j], v => v / (px[j] || 1)), ndvi: ndviN[j] ? ndviSum[j] / ndviN[j] : null, suggestion: null,
+  }));
+  let validation: LandCoverResult['validation'] = null;
+  if (out.confusion) {
+    const cm = out.confusion, rows = cm.map(r => r.reduce((a, b) => a + b, 0)), cols = labels.map((_, j) => cm.reduce((s, r) => s + r[j], 0));
+    const hits = cm.map((r, i) => r[i]);
+    validation = { folds: out.folds, confusion: cm, overall: hits.reduce((a, b) => a + b, 0) / rows.reduce((a, b) => a + b, 0), user: hits.map((h, i) => (rows[i] ? h / rows[i] : null)), producer: hits.map((h, j) => (cols[j] ? h / cols[j] : null)) };
+  }
+  notes.push(
+    `Random forest (Breiman 2001; ${trees} trees in the browser, √bands features per split) on ${d} band${d === 1 ? '' : 's'} (${bands.map(b => `band ${b + 1}`).join(', ')}), trained on ${picked.length.toLocaleString()} pixels from ${shapes.length} shapes labelled by “${field}” (${underShapes.toLocaleString()} under the shapes; at most ${maxPerClass.toLocaleString()} per class, drawn at random). The server version uses 100 trees and 5,000 pixels per class.`,
+  );
+  if (validation)
+    notes.push(`Cross-validation by shape (${out.folds} folds; a shape’s pixels are never split between training and test): ${(validation.overall * 100).toFixed(1)} % of held-out training pixels classified correctly. Training shapes are chosen, not a random sample, so this is not the map’s accuracy: estimate that with a stratified sample.`);
+  else {
+    const few = labels.filter((_, c) => new Set(byClass[c].map(i => group[i])).size < 2);
+    notes.push(`No cross-validation: ${few.join(', ')} ${few.length === 1 ? 'has' : 'have'} only one training shape. Draw at least two per class, apart from each other.`);
+  }
+  if (geo) notes.push(geo.note);
+  if (grids[0].resampleFactor > 1) notes.push(`Classified on a resampled grid (each cell = ${fmt(grids[0].resampleFactor, 3)} original pixels).`);
+  return { filename: raster.meta.filename, bands, k, width, height, classes, stats, iterations: 0, trainingPixels: picked.length, notes, method: 'rf', labels, labelField: field, validation };
 }
