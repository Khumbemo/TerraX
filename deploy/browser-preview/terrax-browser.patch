+test('contours: rings on a cone, Douglas–Peucker within tolerance, gaps split lines, saddles never cross', () => {
+  const n = 61;
+  const r = grid(n, n, (x, y) => -Math.hypot(x + 0.5 - n / 2, y + 0.5 - n / 2)).data;
+  for (const { level, lines } of contourGrid(r, n, n, [-5, -20])) {
+    assert.equal(lines.length, 1);
+    assert.deepEqual(lines[0][0], lines[0][lines[0].length - 1], 'closed ring');
+    assert.ok(lines[0].every(([x, y]) => Math.abs(Math.hypot(x - n / 2, y - n / 2) + level) < 0.15));
+  }
+  const full = contourGrid(r, n, n, [-20])[0].lines[0];
+  const simple = contourGrid(r, n, n, [-20], 0.25)[0].lines[0];
+  assert.ok(simple.length > 8 && simple.length < full.length);
+  const dist = (p: [number, number], a: [number, number], b: [number, number]) => Math.abs((b[0] - a[0]) * (a[1] - p[1]) - (a[0] - p[0]) * (b[1] - a[1])) / Math.hypot(b[0] - a[0], b[1] - a[1]);
+  assert.ok(full.every(p => Math.min(...simple.slice(1).map((q, i) => dist(p, simple[i], q))) <= 0.25 + 1e-9));
+  const gap = grid(8, 6, x => x).data;
+  for (let x = 0; x < 8; x++) gap[2 * 8 + x] = NaN;
+  assert.equal(contourGrid(gap, 8, 6, [5.5])[0].lines.length, 2);
+  assert.equal(contourGrid(Float32Array.from([1, 0, 0, 1]), 2, 2, [0.5])[0].lines.length, 2);
+});
