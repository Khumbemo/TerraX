+    areaHa: area / 1e4, threshold, cover: canopy / area, coverFao: fao / area,
+    height: { median: q(0.5), q1: q(0.25), q3: q(0.75), p95: q(0.95), max: heights.length ? heights[heights.length - 1] : null, mean: heights.length ? heights.reduce((a, b) => a + b, 0) / heights.length : null },
+    classes: HEIGHT_CLASSES.map(([lo, hi], i) => ({ label: Number.isFinite(hi) ? `${lo}–${hi} m` : `≥ ${lo} m`, ha: cls[i] / 1e4 })),
+    trees: { cells, heights: th, count: cells.length, perHa: cells.length / (area / 1e4), minHeight: minTree, meanHeight: th.length ? th.reduce((a, b) => a + b, 0) / th.length : null },
+  };
+}
+
+export function canopyMarkdown(name: string, source: string, r: CanopyResult, notes: string[]): string {
+  const hgt = r.height, t = r.trees;
+  return [
+    '## Dataset', '', `- ${name} (${source})`, `- Area with heights: ${fmt(r.areaHa, 4)} ha`, '', '## Results', '', '| Measure | Value |', '|---|---|',
+    `| Canopy cover (≥ ${fmt(r.threshold, 3)} m) | ${(r.cover * 100).toFixed(1)} % |`,
+    `| Cover of trees ≥ 5 m (FAO forest height) | ${(r.coverFao * 100).toFixed(1)} % |`,
+    `| Canopy height, median (quartiles) | ${fmt(hgt.median, 3)} m (${fmt(hgt.q1, 3)}–${fmt(hgt.q3, 3)}) |`,
+    `| 95th percentile / maximum | ${fmt(hgt.p95, 3)} m / ${fmt(hgt.max, 3)} m |`,
+    `| Tree tops ≥ ${fmt(t.minHeight, 3)} m | ${t.count.toLocaleString()} (${fmt(t.perHa, 3)} per ha; mean height ${fmt(t.meanHeight, 3)} m) |`, '',
+    '| Height class | Area (ha) |', '|---|---|', ...r.classes.map(c => `| ${c.label} | ${fmt(c.ha, 4)} |`), '',
+    '## Method and limits', '', ...notes.map(n => `- ${n}`),
+  ].join('\n');
+}
