@@ -0,0 +1,224 @@
+import { useState } from 'react';
+import { mapImage } from '../../lib/overlay';
+import { groundGeometry, openGeoTiff, sameGrid, type OpenRaster } from '../../lib/rasterio';
+import { fetchSample } from '../../lib/samples';
+import { fmt } from '../../lib/stats';
+import { useToast } from '../../lib/toast';
+import type { ToolOutput } from '../../lib/tools/registry';
+import { CHANGE_CLASSES, ENL_IW_GRD, analyzeRadar, changeRgba, compositeRgba, radarMarkdown, type Quartiles, type RadarResult } from '../../lib/tools/radar';
+import { boundaryMask, type Boundary } from '../../lib/zonal';
+import FileDrop from '../FileDrop';
+import RgbaCanvas from '../RgbaCanvas';
+import { Stat } from './ForestLossTool';
+
+interface Props {
+  onOutput: (out: ToolOutput | null) => void;
+  boundary: Boundary | null;
+}
+
+type View = 'composite' | 'change';
+const SAMPLES = ['samples/s1_vv_vh_2023-01-08_synthetic.tif', 'samples/s1_vv_vh_2024-01-03_synthetic.tif'];
+
+function polIndex(r: OpenRaster, pol: 'VV' | 'VH'): number {
+  const names = r.meta.bandNames ?? [];
+  const i = names.findIndex(n => n.toUpperCase().includes(pol));
+  return i >= 0 ? i : pol === 'VV' ? 0 : Math.min(1, r.meta.bands - 1);
+}
+
+export default function RadarTool({ onOutput, boundary }: Props) {
+  const notify = useToast();
+  const [before, setBefore] = useState<OpenRaster | null>(null);
+  const [after, setAfter] = useState<OpenRaster | null>(null);
+  const [win, setWin] = useState('5');
+  const [threshold, setThreshold] = useState('3');
+  const [busy, setBusy] = useState(false);
+  const [res, setRes] = useState<{ r: RadarResult; areas: [number, number, number] | null; notes: string[] } | null>(null);
+  const [view, setView] = useState<View>('composite');
+  const fail = (m: string) => notify(m, 'error');
+
+  const open = async (file: File) => {
+    const r = await openGeoTiff(file);
+    if (r.meta.bands < 2) throw new Error(`${file.name} has one band; Sentinel-1 analysis needs VV and VH.`);
+    return r;
+  };
+
+  const run = async (a = before, b = after) => {
+    if (!a) return fail('Add a Sentinel-1 image first.');
+    const thr = Number(threshold);
+    if (!Number.isFinite(thr) || thr <= 0) return fail('Set the change threshold as a positive number of dB, for example 3.');
+    if (b && !sameGrid(a.meta, b.meta)) return fail('The two images are not on the same grid. Export both with the same region, scale and CRS (and from the same relative orbit).');
+    setBusy(true);
+    try {
+      const imgs = [];
+      for (const r of b ? [a, b] : [a]) {
+        const [vv, vh] = await r.readBands([polIndex(r, 'VV'), polIndex(r, 'VH')]);
+        imgs.push({ name: r.meta.filename, vv, vh });
+      }
+      let mask: Uint8Array | null = null;
+      const notes: string[] = [];
+      if (boundary) {
+        const m = boundaryMask(a.meta, imgs[0].vv, boundary);
+        mask = m.mask;
+        notes.push(`Limited to the analysis boundary (${m.inside.toLocaleString()} cells inside it).`);
+      }
+      const r = analyzeRadar(imgs, mask, Number(win), ENL_IW_GRD, thr);
+      const geo = groundGeometry(a.meta, imgs[0].vv);
+      let areas: [number, number, number] | null = null;
+      if (r.change && geo) {
+        areas = [0, 0, 0];
+        for (let k = 0; k < r.change.classes.length; k++) {
+          const c = r.change.classes[k];
+          if (c) areas[c - 1] += geo.cellArea(Math.floor(k / r.width)) / 1e4;
+        }
+      }
+      notes.unshift(
+        `Speckle: Lee (1980) filter, ${win} × ${win} window, ENL ${ENL_IW_GRD} (Sentinel-1 IW GRDH), computed in linear power; statistics are reported in dB.`,
+        `Inputs were read as ${r.dates.map(d => `${d.name}: ${d.scale === 'db' ? 'dB' : 'linear power'}`).join(', ')} (detected from the values).`,
+        'RVI = 4 σ⁰VH / (σ⁰VV + σ⁰VH), a dual-polarisation vegetation index: higher where volume scattering from canopies is strong.',
+      );
+      if (r.change)
+        notes.push(
+          `Change: VH log ratio 10·log₁₀(after / before); ≤ −${fmt(thr, 3)} dB is a decrease (the usual sign of clearing), ≥ +${fmt(thr, 3)} dB an increase. Soil moisture, rain, flooding and crop growth also move backscatter; compare images from the same season and relative orbit, and check flagged areas on optical imagery.`,
+        );
+      if (geo) notes.push(geo.note);
+      for (const im of b ? [a, b] : [a]) notes.push(...im.meta.warnings);
+      setRes({ r, areas, notes });
+      setView(r.change ? 'change' : 'composite');
+      const rgba = r.change ? changeRgba(r.change.classes) : compositeRgba(r);
+      onOutput({
+        tool: 'radar',
+        name: imgs.map(i => i.name).join(' → '),
+        markdown: radarMarkdown(r, areas, notes),
+        map: {
+          bounds: a.meta.latLngBounds,
+          image: mapImage(rgba, r.width, r.height, a.meta.latLngBounds, r.change ? 'Backscatter change (VH)' : 'Sentinel-1 false colour', r.change ? CHANGE_CLASSES.filter(c => c.id !== 2).map(c => ({ color: `rgb(${c.color.join(',')})`, label: c.label })) : [], a.meta),
+        },
+      });
+    } catch (err) {
+      fail(err instanceof Error ? err.message : 'The radar analysis failed.');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const load = async (file: File, slot: 'before' | 'after') => {
+    try {
+      const r = await open(file);
+      if (slot === 'before') setBefore(r);
+      else setAfter(r);
+      setRes(null);
+      onOutput(null);
+    } catch (err) {
+      fail(err instanceof Error ? err.message : `${file.name} could not be read.`);
+    }
+  };
+
+  const r = res?.r;
+  const q = (s: Quartiles | null, unit = ' dB') => (s ? `${fmt(s.median, 3)}${unit}` : '—');
+  const area = (i: number) => (res?.areas ? `${fmt(res.areas[i], 4)} ha` : `${(r?.change?.counts[i] ?? 0).toLocaleString()} px`);
+  const share = (i: number) => (r?.change ? (r.change.counts[i] / (r.change.counts.reduce((x, y) => x + y, 0) || 1)) * 100 : 0);
+
+  return (
+    <div className="tool-body">
+      <p className="tool-intro">
+        Upload Sentinel-1 backscatter with VV and VH bands (for example COPERNICUS/S1_GRD exported from Earth Engine in dB, or ASF RTC in linear power). Radar sees
+        through cloud. Add a second image from the same relative orbit to map change: a drop in VH is the usual sign of clearing.
+      </p>
+      <FileDrop id="radar-before" label="Image (before, or the only one)" accept=".tif,.tiff" hint="GeoTIFF · VV and VH bands" busy={busy} loaded={before?.meta.filename} onFile={f => load(f, 'before')} />
+      <FileDrop id="radar-after" label="Second image (after, optional)" accept=".tif,.tiff" hint="Same grid and relative orbit" compact loaded={after?.meta.filename} onFile={f => load(f, 'after')} />
+      <div className="param-row">
+        <label className="param" title="Lee speckle filter window (pixels); 1 switches the filter off.">
+          <span>Filter window</span>
+          <select id="radar-window" value={win} onChange={e => setWin(e.target.value)}>
+            {['1', '3', '5', '7', '9'].map(v => (
+              <option key={v} value={v}>
+                {v === '1' ? 'off' : `${v} × ${v}`}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label className="param">
+          <span>Change threshold (dB)</span>
+          <input id="radar-threshold" type="number" min="0.1" step="0.5" value={threshold} onChange={e => setThreshold(e.target.value)} />
+        </label>
+        <div className="button-row push-right">
+          <button
+            type="button"
+            className="btn"
+            disabled={busy}
+            onClick={async () => {
+              try {
+                const [a, b] = await Promise.all(SAMPLES.map(async p => open(await fetchSample(p, 'image/tiff'))));
+                setBefore(a);
+                setAfter(b);
+                await run(a, b);
+              } catch (err) {
+                fail(err instanceof Error ? err.message : 'The sample could not be loaded.');
+              }
+            }}
+          >
+            Try synthetic pair
+          </button>
+          <button type="button" id="radar-run" className="btn btn-primary" disabled={!before || busy} onClick={() => run()}>
+            {busy ? 'Filtering…' : after ? 'Analyse change' : 'Analyse'}
+          </button>
+        </div>
+      </div>
+
+      {r && res && (
+        <div className="result-block">
+          <div className="stat-grid">
+            <Stat label="Median VH" value={q(r.dates[r.dates.length - 1].vh)} />
+            <Stat label="Median VV" value={q(r.dates[r.dates.length - 1].vv)} />
+            {r.change && <Stat label="VH decrease" value={`${area(0)} (${share(0).toFixed(1)} %)`} tone={share(0) > 1 ? 'bad' : undefined} />}
+            {r.change && <Stat label="VH increase" value={`${area(2)} (${share(2).toFixed(1)} %)`} />}
+          </div>
+          {r.change && (
+            <div className="view-toggles" role="tablist">
+              {(['change', 'composite'] as View[]).map(v => (
+                <button key={v} type="button" role="tab" aria-selected={view === v} className={view === v ? 'active' : ''} onClick={() => setView(v)}>
+                  {v === 'change' ? 'Change' : 'False colour'}
+                </button>
+              ))}
+            </div>
+          )}
+          <figure className="raster-figure">
+            <RgbaCanvas rgba={view === 'change' && r.change ? changeRgba(r.change.classes) : compositeRgba(r)} width={r.width} height={r.height} label={view === 'change' ? 'Backscatter change' : 'Sentinel-1 false colour'} />
+            <figcaption className="field-hint">
+              {view === 'change' ? 'Red: VH decrease beyond the threshold; blue: increase; unchanged cells are clear.' : 'Red VV, green VH, blue VV/VH: vegetation looks green, bare and built ground magenta to white, water dark.'}
+            </figcaption>
+          </figure>
+          <div className="tabular-view">
+            <table>
+              <thead>
+                <tr>
+                  <th>Image</th>
+                  <th>VV (dB)</th>
+                  <th>VH (dB)</th>
+                  <th>VH/VV (dB)</th>
+                  <th>RVI</th>
+                </tr>
+              </thead>
+              <tbody>
+                {r.dates.map(d => (
+                  <tr key={d.name}>
+                    <td>{d.name}</td>
+                    <td className="num">{q(d.vv, '')}</td>
+                    <td className="num">{q(d.vh, '')}</td>
+                    <td className="num">{q(d.ratio, '')}</td>
+                    <td className="num">{q(d.rvi, '')}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          <ul className="hint-list">
+            {[...new Set(res.notes)].map(n => (
+              <li key={n}>{n}</li>
+            ))}
+          </ul>
+        </div>
+      )}
+    </div>
+  );
+}
