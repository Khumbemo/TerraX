+/** Cells that are the highest within half their expected crown width (ties go to the first in scan order). */
+export function treeTops(s: Float64Array, w: number, h: number, minH: number, cell: number): number[] {
+  const out: number[] = [];
+  for (let r = 0; r < h; r++) for (let c = 0; c < w; c++) {
+    const v = s[r * w + c];
+    if (!(v >= minH)) continue;
+    const rad = Math.max(1, Math.floor(crownWidth(v) / 2 / cell + 0.5));
+    let top = true;
+    for (let dr = -rad; dr <= rad && top; dr++) {
+      const rr = r + dr;
+      if (rr < 0 || rr >= h) continue;
+      for (let dc = -rad; dc <= rad; dc++) {
+        const cc = c + dc;
