+    plots: n, a: corr * Math.exp(f.b0), b: f.b1, sigmaLog: s, r2Log: n > 2 ? 1 - f.rss / syy : null, rmse: Math.sqrt(mse / n), looRmse: Math.sqrt(loo / n),
