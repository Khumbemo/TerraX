+  const { readFileSync } = await import('node:fs');
+  const dir = new URL('../public/data/samples/', import.meta.url);
+  const boundary = { name: 'p', areaM2: 0, geojson: JSON.parse(readFileSync(new URL('plot_boundary_synthetic.geojson', dir), 'utf8')) };
+  // A 2100 × 2100 (4.4 MP) image around the sample plot at 0.1 m; a whole-raster read would coarsen it.
+  const src = await openGeoTiff(new File([readFileSync(new URL('plot_2024-02-08_synthetic.tif', dir))], 'src.tif'));
+  const [sx0, , , sy1] = src.meta.bbox!;
+  const [g] = [await src.readBands([0, 1, 2])];
+  const n = 2100, res = 0.1, e0 = sx0 - 5, n0 = sy1 + 5;
+  const rnd = lcg(7);
+  const data = new Uint8Array(n * n * 3);
+  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) {
+    const sc = Math.floor((e0 + (c + 0.5) * res - sx0) / src.meta.pixelSize![0]), sr = Math.floor((sy1 - (n0 - (r + 0.5) * res)) / src.meta.pixelSize![1]);
+    for (let b = 0; b < 3; b++) {
+      const v = sc >= 0 && sr >= 0 && sc < g[b].width && sr < g[b].height ? g[b].data[sr * g[b].width + sc] : 60;
+      data[(r * n + c) * 3 + b] = Math.max(0, Math.min(255, Math.round(v + (rnd() - 0.5) * 30)));
+    }
+  }
+  const buf = await writeArrayBuffer(data, { width: n, height: n, SamplesPerPixel: 3, BitsPerSample: [8, 8, 8], SampleFormat: [1, 1, 1], PlanarConfiguration: 1, ModelPixelScale: [res, res, 0], ModelTiepoint: [0, 0, 0, e0, n0, 0], GTModelTypeGeoKey: 1, GTRasterTypeGeoKey: 1, ProjectedCSTypeGeoKey: 32646 });
+  const big = await openGeoTiff(new File([buf], 'big.tif'));
+  const before = await openGeoTiff(new File([readFileSync(new URL('plot_2019-02-10_synthetic.tif', dir))], 'before.tif'));
+  // Reference: the same file held at full resolution, sampled without window reads.
+  const planes = [0, 1, 2].map(b => Float32Array.from({ length: n * n }, (_, k) => data[k * 3 + b]));
+  const native = { meta: big.meta, readBands: async (ix: number[]) => ix.map(i => ({ width: n, height: n, data: planes[i], resampleFactor: 1 })) };
+  const got = await prepareGeoStack([{ raster: before, label: 'a', date: null }, { raster: big, label: 'b', date: null }], boundary, 15);
+  const ref = await prepareGeoStack([{ raster: before, label: 'a', date: null }, { raster: native, label: 'b', date: null }], boundary, 15);
+  assert.equal(got.cellM, 0.1);
+  for (let b = 0; b < 3; b++) assert.deepEqual(got.layers[1].rgb[b], ref.layers[1].rgb[b]);
+  // Decimated windows keep exactly every step-th pixel.
+  const full = await big.readWindow!([1], 7, 5, 1007, 905);
+  const thin = await big.readWindow!([1], 7, 5, 1007, 905, full.width * full.height / 10);
+  assert.equal(thin.step, 4);
+  for (let i = 0; i < thin.height; i++) for (let j = 0; j < thin.width; j++) assert.equal(thin.data[0][i * thin.width + j], full.data[0][i * 4 * full.width + j * 4]);
+});
