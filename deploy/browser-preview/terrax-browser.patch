+test('random forest separates learnable classes', () => {
+  let s = 3;
+  const r = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 2 ** 32);
+  const n = 3000, d = 3, X = new Float64Array(n * d), y = new Int32Array(n);
+  for (let i = 0; i < n; i++) {
+    for (let a = 0; a < d; a++) X[i * d + a] = r();
+    y[i] = X[i * d] > 0.6 ? 2 : X[i * d + 1] > 0.5 ? 1 : 0;
+  }
+  const f = fitForest(X, y, d, 3, 30, 7);
+  const Q = new Float64Array(2000 * d).map(() => r());
+  const p = predictForest(f, Q, 2000);
+  let ok = 0;
+  for (let i = 0; i < 2000; i++) ok += +(p[i] === (Q[i * d] > 0.6 ? 2 : Q[i * d + 1] > 0.5 ? 1 : 0));
+  assert.ok(ok / 2000 > 0.97, `accuracy ${ok / 2000}`);
