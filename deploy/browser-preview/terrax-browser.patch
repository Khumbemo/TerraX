+  for (let i = 0; i < n; i++) mse += (A[i] - corr * Math.exp(f.b0 + f.b1 * x[i])) ** 2;
+  const ybar = y.reduce((a, b) => a + b, 0) / n;
+  const syy = y.reduce((a, v) => a + (v - ybar) ** 2, 0);
+  let loo = 0; // leave-one-out, on the Mg/ha scale
+  for (let i = 0; i < n; i++) {
+    const fi = fitLine(x.filter((_, j) => j !== i), y.filter((_, j) => j !== i));
+    const si = n > 3 ? fi.rss / (n - 3) : s2;
+    loo += (Math.exp(si / 2) * Math.exp(fi.b0 + fi.b1 * x[i]) - A[i]) ** 2;
+  }
+  const est = new Float64Array(cellsTch.length);
+  const lx: number[] = [], lha: number[] = [];
