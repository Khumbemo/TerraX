+  const d = 4e-6;
+  const square = ([x, y]: [number, number], n: number) => ({ type: 'Feature', properties: { trees: n }, geometry: { type: 'Polygon', coordinates: [[[x - d, y - d], [x + d, y - d], [x + d, y + d], [x - d, y + d], [x - d, y - d]]] } });
+  const feats = [...tops.slice(0, 3).map((t, i) => square(t.geometry.coordinates, [2, 1, 3][i])), square([10, 10], 5)];
