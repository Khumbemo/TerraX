+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import type { FeatureCollection } from 'geojson';
+import { measureSurvey } from '../src/lib/tools/survey';
+
+const close = (a: number, b: number, tol: number) => assert.ok(Math.abs(a - b) <= tol, `expected ${b} ± ${tol}, got ${a}`);
+
+test('survey matches the Python server (pyproj, Karney 2013) to the millimetre', () => {
+  const fc = JSON.parse(readFileSync(new URL('../public/data/samples/survey_plot_synthetic.geojson', import.meta.url), 'utf8')) as FeatureCollection;
+  const f = measureSurvey('survey_plot_synthetic.geojson', 'GeoJSON', fc, []).features[0];
+  // Reference: pyproj.Geod(ellps="WGS84").polygon_area_perimeter / .inv on the same file.
+  close(f.area!, 1452286.2196603715, 1e-3);
+  close(f.length!, 4604.879201376801, 1e-3);
+  close(f.legs[0].distance, 936.1720348490343, 1e-3);
+  close(f.legs[0].bearing, 217.21319091871231, 1e-6);
+  assert.match(f.method, /geodesic/);
+});
+
+test('geometries without coordinates measure as nothing instead of crashing', () => {
+  const geoms = [{ type: 'Polygon' }, { type: 'LineString', coordinates: null }, { type: 'Point', coordinates: [] }, { type: 'MultiPoint', coordinates: [[]] }];
+  const fc = { type: 'FeatureCollection', features: geoms.map(geometry => ({ type: 'Feature', properties: {}, geometry })) } as unknown as FeatureCollection;
+  assert.throws(() => measureSurvey('plot.geojson', 'GeoJSON', fc, []), /no measurable|no polygons|nothing to measure/i);
+});
