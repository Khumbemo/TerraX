new file mode 100644
index 0000000..9ca0ab6
--- /dev/null
+++ b/src/lib/tools/randomforest.ts
@@ -0,0 +1,173 @@
+// Random forest classifier (Breiman 2001): CART trees on bootstrap samples, Gini splits over √d random features
+// per node, grown to purity; prediction averages the leaves' class fractions (as scikit-learn's predict).
+import { rng } from './kmeans';
+
+export interface Forest {
+  classes: number;
+  d: number;
+  /** Per node: feature (−1 = leaf), threshold, left and right child (absolute indices). */
+  feature: Int32Array;
+  threshold: Float64Array;
+  left: Int32Array;
+  right: Int32Array;
+  /** Leaf class fractions, `classes` per node. */
+  value: Float64Array;
+  roots: Int32Array;
+}
+
+/** Fits `trees` CART trees; X is n × d row-major, y holds class indices 0..classes−1. */
+export function fitForest(X: Float64Array, y: Int32Array, d: number, classes: number, trees = 100, seed = 7): Forest {
+  const n = y.length;
+  const rand = rng(seed);
+  const mtry = Math.max(1, Math.floor(Math.sqrt(d)));
+  const feature: number[] = [], threshold: number[] = [], left: number[] = [], right: number[] = [], value: number[] = [], roots: number[] = [];
+  const counts = new Float64Array(classes), leftCounts = new Float64Array(classes);
+
+  const leaf = (idx: Int32Array, w: Float64Array) => {
+    const at = feature.length;
+    feature.push(-1), threshold.push(0), left.push(-1), right.push(-1);
+    counts.fill(0);
+    let total = 0;
+    for (const i of idx) (counts[y[i]] += w[i]), (total += w[i]);
+    for (let c = 0; c < classes; c++) value.push(total ? counts[c] / total : 0);
+    return at;
+  };
+
+  const grow = (idx: Int32Array, w: Float64Array): number => {
+    counts.fill(0);
+    let total = 0;
+    for (const i of idx) (counts[y[i]] += w[i]), (total += w[i]);
+    let pure = 0;
+    for (let c = 0; c < classes; c++) if (counts[c] > 0) pure++;
+    if (pure <= 1 || idx.length < 2) return leaf(idx, w);
+    let parentGini = 1;
+    for (let c = 0; c < classes; c++) parentGini -= (counts[c] / total) ** 2;
+    // √d features drawn without replacement (partial Fisher–Yates).
+    const feats = Array.from({ length: d }, (_, a) => a);
+    for (let a = 0; a < mtry; a++) {
+      const b = a + Math.floor(rand() * (d - a));
+      [feats[a], feats[b]] = [feats[b], feats[a]];
+    }
+    let bestGain = 1e-12, bestF = -1, bestT = 0;
+    const order = Array.from(idx);
+    for (let fi = 0; fi < mtry; fi++) {
+      const f = feats[fi];
+      order.sort((a, b) => X[a * d + f] - X[b * d + f]);
+      leftCounts.fill(0);
+      let lw = 0;
+      for (let p = 0; p < order.length - 1; p++) {
+        const i = order[p];
+        leftCounts[y[i]] += w[i];
+        lw += w[i];
+        const v = X[i * d + f], next = X[order[p + 1] * d + f];
+        if (v === next) continue;
+        const rw = total - lw;
+        let gl = 1, gr = 1;
+        for (let c = 0; c < classes; c++) {
+          gl -= (leftCounts[c] / lw) ** 2;
+          gr -= ((counts[c] - leftCounts[c]) / rw) ** 2;
+        }
+        const gain = parentGini - (lw / total) * gl - (rw / total) * gr;
+        if (gain > bestGain) (bestGain = gain), (bestF = f), (bestT = (v + next) / 2);
+      }
+    }
+    if (bestF < 0) return leaf(idx, w);
+    const at = feature.length;
+    feature.push(bestF), threshold.push(bestT), left.push(-1), right.push(-1);
+    for (let c = 0; c < classes; c++) value.push(0);
+    const l: number[] = [], r: number[] = [];
+    for (const i of idx) (X[i * d + bestF] <= bestT ? l : r).push(i);
+    const li = grow(Int32Array.from(l), w);
+    left[at] = li;
+    const ri = grow(Int32Array.from(r), w);
+    right[at] = ri;
+    return at;
+  };
+
+  for (let t = 0; t < trees; t++) {
+    // Bootstrap: n draws with replacement, kept as integer weights on the distinct rows.
+    const w = new Float64Array(n);
+    for (let i = 0; i < n; i++) w[Math.floor(rand() * n)]++;
+    const idx: number[] = [];
+    for (let i = 0; i < n; i++) if (w[i] > 0) idx.push(i);
+    roots.push(grow(Int32Array.from(idx), w));
+  }
+  return { classes, d, feature: Int32Array.from(feature), threshold: Float64Array.from(threshold), left: Int32Array.from(left), right: Int32Array.from(right), value: Float64Array.from(value), roots: Int32Array.from(roots) };
+}
+
+/** Class index per row of X (n × d): argmax of the summed leaf fractions, first maximum on ties. */
+export function predictForest(f: Forest, X: Float64Array | Float32Array, n: number, out = new Int32Array(n)): Int32Array {
+  const { d, classes: k, feature, threshold, left, right, value, roots } = f;
+  const acc = new Float64Array(k);
+  for (let i = 0; i < n; i++) {
+    acc.fill(0);
+    const o = i * d;
+    for (let t = 0; t < roots.length; t++) {
+      let node = roots[t];
+      while (feature[node] >= 0) node = X[o + feature[node]] <= threshold[node] ? left[node] : right[node];
+      for (let c = 0; c < k; c++) acc[c] += value[node * k + c];
+    }
+    let best = 0;
+    for (let c = 1; c < k; c++) if (acc[c] > acc[best]) best = c;
+    out[i] = best;
+  }
+  return out;
+}
+
+export interface ForestJob {
+  /** Training pixels (n × d), classes 0..k−1, and the training shape each pixel came from. */
+  X: Float64Array;
+  y: Int32Array;
+  groups: Int32Array;
+  d: number;
+  k: number;
+  /** Pixels to classify (m × d). */
+  Q: Float32Array;
+  trees: number;
+  seed: number;
+}
+
+export interface ForestOutcome {
+  pred: Int32Array;
+  folds: number;
+  /** Cross-validation counts by shape, rows: predicted, columns: reference; null with fewer than two shapes in a class. */
+  confusion: number[][] | null;
+}
+
+/**
+ * Cross-validation grouped by training shape (a shape's pixels never split between training and test; each class's
+ * shapes are dealt to the folds in turn, so every fold holds every class), then the forest on all pixels.
+ */
+export function trainValidatePredict(j: ForestJob): ForestOutcome {
+  const { X, y, groups, d, k } = j;
+  const byClass: number[][] = Array.from({ length: k }, () => []);
+  const seen = new Set<number>();
+  for (let i = 0; i < y.length; i++) if (!seen.has(groups[i])) seen.add(groups[i]), byClass[y[i]].push(groups[i]);
+  const folds = Math.min(5, ...byClass.map(g => g.length));
+  let confusion: number[][] | null = null;
+  if (folds >= 2) {
+    const rand = rng(j.seed + 303);
+    const foldOf = new Map<number, number>();
+    for (const g of byClass) {
+      for (let a = g.length - 1; a > 0; a--) {
+        const b = Math.floor(rand() * (a + 1));
+        [g[a], g[b]] = [g[b], g[a]];
+      }
+      g.forEach((id, p) => foldOf.set(id, p % folds));
+    }
+    confusion = Array.from({ length: k }, () => new Array(k).fill(0));
+    for (let f = 0; f < folds; f++) {
+      const tr: number[] = [], te: number[] = [];
+      for (let i = 0; i < y.length; i++) (foldOf.get(groups[i]) === f ? te : tr).push(i);
+      const Xt = new Float64Array(tr.length * d), yt = new Int32Array(tr.length);
+      tr.forEach((i, r) => (Xt.set(X.subarray(i * d, i * d + d), r * d), (yt[r] = y[i])));
+      const model = fitForest(Xt, yt, d, k, j.trees, j.seed + f);
+      const Xe = new Float64Array(te.length * d);
+      te.forEach((i, r) => Xe.set(X.subarray(i * d, i * d + d), r * d));
+      const p = predictForest(model, Xe, te.length);
+      te.forEach((i, r) => confusion![p[r]][y[i]]++);
+    }
+  }
+  const forest = fitForest(X, y, d, k, j.trees, j.seed);
+  return { pred: predictForest(forest, j.Q, j.Q.length / d), folds, confusion };
+}
