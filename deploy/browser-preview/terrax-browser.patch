+    async resolveId(id, importer) {
+      if (!id.endsWith('.wasm?base64')) return null;
+      const r = await this.resolve(id.slice(0, -'?base64'.length), importer, { skipSelf: true });
+      return r ? `${r.id}?base64` : null;
+    },
+    load(id) {
+      if (!id.endsWith('.wasm?base64')) return null;
+      return `export default ${JSON.stringify(readFileSync(id.slice(0, -'?base64'.length)).toString('base64'))};`;
+    },
+  };
+}
