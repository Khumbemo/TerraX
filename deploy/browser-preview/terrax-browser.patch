+test('D∞ upslope dependence: Σ area × share equals the outlet’s D∞ area, and matches flow pushed by brute force', async () => {
+  const { dinfDependence, dinfFlow, fillDepressions } = await import('../src/lib/tools/hydrology');
+  const n = 30;
+  let seed = 5;
+  const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
+  const z = grid(n, n, (x, y) => 0.3 * x + 0.2 * y + 2 * Math.sin(x / 5) * Math.cos(y / 7) + (rand() - 0.5) * 0.6).data;
+  const geo = { spacing: () => ({ dx: 1, dy: 1 }), cellArea: () => 1 };
+  const filled = fillDepressions(z, n, n).filled;
+  const d = dinfFlow(filled, n, n, geo);
+  const F_R1 = [0, -1, -1, 0, 0, 1, 1, 0], F_C1 = [1, 0, 0, -1, -1, 0, 0, 1], F_R2 = [-1, -1, -1, -1, 1, 1, 1, 1], F_C2 = [1, 1, -1, -1, -1, -1, 1, 1];
+  const order = Array.from({ length: n * n }, (_, i) => i).sort((a, b) => filled[b] - filled[a] || a - b);
+  for (const outlet of [15 * n + 15, 3 * n + 3]) {
+    const dep = dinfDependence(d.facet, d.share, n, n, outlet);
+    assert.equal(dep[outlet], 1);
+    assert.ok(Math.abs(dep.reduce((s, v) => s + v, 0) - d.acc[outlet]) < 1e-3 * d.acc[outlet]);
+    for (let start = 0; start < n * n; start += 37) {
+      const mass = new Float64Array(n * n);
+      mass[start] = 1;
+      let reached = 0;
+      for (const k of order) {
+        const m = mass[k];
+        if (!m) continue;
+        if (k === outlet) {
+          reached += m;
+          continue;
+        }
+        const f = d.facet[k];
+        if (f < 0) continue;
+        const r = Math.floor(k / n), c = k % n, p2 = d.share[k];
+        mass[(r + F_R1[f]) * n + c + F_C1[f]] += m * (1 - p2);
+        mass[(r + F_R2[f]) * n + c + F_C2[f]] += m * p2;
+      }
+      assert.ok(Math.abs(dep[start] - reached) < 1e-5, `cell ${start}: ${dep[start]} vs ${reached}`);
+    }
+  }
+});
