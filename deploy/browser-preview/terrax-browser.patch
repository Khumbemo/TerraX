+}
+
+export function analyzeCanopy(chm: Float32Array, w: number, h: number, cellArea: (row: number) => number, cellM: number, threshold = 2, minTree = 5): CanopyResult {
+  let area = 0, canopy = 0, fao = 0;
+  const heights: number[] = [];
+  const cls = HEIGHT_CLASSES.map(() => 0);
+  for (let k = 0; k < chm.length; k++) {
+    const v = chm[k];
+    if (Number.isNaN(v)) continue;
+    const a = cellArea(Math.floor(k / w));
