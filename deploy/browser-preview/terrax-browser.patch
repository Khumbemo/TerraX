@@ -0,0 +1,98 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { accountError, accountStore, DOC_LIMIT, fitReport, projectHead } from '../src/lib/account-store';
+import { buildProject } from '../src/lib/project';
+import type { ReportRecord } from '../src/lib/types';
+
+const report = (id: string, figureKb: number[]): ReportRecord => ({
+  id,
+  title: `Report ${id}`,
+  datasetName: 'demo.tif',
+  createdAt: `2026-10-0${id}T00:00:00Z`,
+  source: 'local',
+  content: '## Results\n\nNDVI 0.62',
+  figures: figureKb.map((kb, i) => ({ title: `Figure ${i}`, dataUrl: `data:image/png;base64,${'A'.repeat(kb * 1024)}`, width: 10, height: 10 })),
+});
+
+test('a report keeps every figure that fits under the document limit, in order', () => {
+  assert.equal(fitReport(report('1', [10, 20])).dropped, 0);
+  const { doc, dropped } = fitReport(report('2', [100, 200, 100]));
+  assert.equal(dropped, 1);
+  assert.deepEqual(doc.figures?.map(f => f.title), ['Figure 0', 'Figure 2']);
+  assert.ok(new TextEncoder().encode(JSON.stringify(doc)).length <= DOC_LIMIT);
+  assert.throws(() => fitReport({ ...report('3', []), content: 'x'.repeat(DOC_LIMIT + 1) }), /too large to save/);
+});
+
+test('a boundary too detailed for one document is refused with advice', () => {
+  const big = buildProject({ target: null, reports: [], preferences: {}, boundary: { name: 'b', areaM2: 1, geojson: { type: 'FeatureCollection', features: [] }, pad: 'x'.repeat(DOC_LIMIT) } as never });
+  assert.throws(() => projectHead('p', big), /too detailed/);
+});
+
+/** An in-memory stand-in for the artifact store, with its path grammar: documents at even segment counts, collections odd. */
+function fakeRuntime(uid: string | null) {
+  const docs = new Map<string, Record<string, unknown>>();
+  let n = 0;
+  const segs = (p: string) => p.split('/').length;
+  const docRef = (path: string): unknown => {
+    assert.equal(segs(path) % 2, 0, `document path ${path}`);
+    return {
+      id: path.split('/').pop(),
+      get: async () => ({ id: path.split('/').pop(), exists: docs.has(path), data: () => docs.get(path) }),
+      set: async (d: Record<string, unknown>) => {
+        assert.ok(new TextEncoder().encode(JSON.stringify(d)).length <= 256 * 1024, 'document over 256 KiB');
+        docs.set(path, structuredClone(d));
+      },
+      delete: async () => void docs.delete(path), // nested documents survive, as in the real store
+      collection: (c: string) => collRef(`${path}/${c}`),
+    };
+  };
+  const collRef = (path: string): unknown => {
+    assert.equal(segs(path) % 2, 1, `collection path ${path}`);
+    return {
+      doc: (id?: string) => docRef(`${path}/${id ?? `auto${++n}`}`),
+      get: async () => ({
+        docs: [...docs.keys()].filter(k => k.startsWith(`${path}/`) && segs(k) === segs(path) + 1).map(k => ({ id: k.split('/').pop(), exists: true, data: () => docs.get(k) })),
+      }),
+    };
+  };
+  return { docs, rt: { use: async (name: string) => (name === 'db' ? { doc: docRef } : name === 'user' ? { id: async () => uid } : null) } };
+}
+
+test('save, list, open and delete round-trip under the viewer’s private path', async () => {
+  const g = globalThis as { claude?: unknown };
+  assert.equal(await accountStore(), null); // outside claude.ai: no store
+  const { docs, rt } = fakeRuntime('u_abc');
+  g.claude = rt;
+  try {
+    const store = await accountStore();
+    assert.ok(store);
+    const p = buildProject({ target: { lat: 25.67, lon: 94.11, name: 'Kohima' }, boundary: null, preferences: { units: 'metric' }, reports: [report('1', [10]), report('2', [100, 200, 100])] });
+    const saved = await store.save('Kohima survey', p);
+    assert.equal(saved.reports, 2);
+    assert.equal(saved.droppedFigures, 1);
+    assert.ok([...docs.keys()].every(k => k.startsWith('data/users/u_abc/terrax/projects/')));
+    const list = await store.list();
+    assert.deepEqual(list.map(x => x.name), ['Kohima survey']);
+    const back = await store.open(list[0].id);
+    assert.deepEqual(back.target, p.target);
+    assert.deepEqual(back.reports.map(r => r.id), ['1', '2']);
+    assert.equal(back.reports[1].figures?.length, 2);
+    await store.remove(list[0].id);
+    assert.equal(docs.size, 0); // reports deleted too, not left behind under the parent
+    assert.deepEqual(await store.list(), []);
+  } finally {
+    delete g.claude;
+  }
+  g.claude = fakeRuntime(null).rt; // signed out: no private subtree, so no store
+  try {
+    assert.equal(await accountStore(), null);
+  } finally {
+    delete g.claude;
+  }
+});
+
+test('store errors become advice', () => {
+  assert.match(accountError({ code: 'invalid_argument' }), /Contributor access/);
+  assert.match(accountError({ code: 'quota_exceeded' }), /full/);
+  assert.match(accountError(new Error('boom')), /boom/);
+});
