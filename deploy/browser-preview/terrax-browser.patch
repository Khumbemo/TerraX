+}
+
+/** Side of a block of about the plots' (median geodesic) area, in cells. */
+export function blockSide(feats: PlotFeature[], cellM: number): number {
+  const areas = feats.map(f => polygonAreaM2(f.geometry)).sort((a, b) => a - b);
+  if (!areas.length) return 1;
+  const m = areas.length % 2 ? areas[(areas.length - 1) / 2] : (areas[areas.length / 2 - 1] + areas[areas.length / 2]) / 2;
+  return Math.max(1, Math.round(Math.sqrt(m) / cellM));
+}
+
+const grouped = (v: number) => Math.round(v).toLocaleString('en-US');
+
+export function calibratedRow(c: Calibrated, fmt: (v: number, d?: number) => string): string {
+  const ci = c.ci95 ? `; 95 % CI ${grouped(c.ci95[0])}–${grouped(c.ci95[1])}` : '; one plot, so no interval';
+  const per = c.perHa ? `, ${fmt(c.perHa, 3)} per ha` : '';
+  return `| Trees, calibrated by ${c.plots} field plot${c.plots === 1 ? '' : 's'} | ${grouped(c.total)}${per}${ci} |`;
+}
+
+export function biomassRows(b: Biomass, fmt: (v: number, d?: number) => string): string[] {
+  const per = b.meanMgHa ? ` (${fmt(b.meanMgHa, 3)} Mg/ha)` : '';
+  return [
+    `| Above-ground biomass, from ${b.plots} field plots | ${grouped(b.totalMg)} Mg${per}; 95 % CI ${grouped(b.ci95Mg[0])}–${grouped(b.ci95Mg[1])} Mg |`,
+    `| Carbon / CO₂e | ${grouped(b.carbonMg)} Mg C / ${grouped(b.co2eMg)} Mg CO₂e |`,
+  ];
+}
