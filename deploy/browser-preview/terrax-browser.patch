+test('Lee filter keeps the mean, cuts speckle about √n-fold and keeps a 6 dB edge', () => {
+  let seed = 7;
+  const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 2 ** 32);
+  // Speckle with ENL 4.4: Gamma(4.4, 1/4.4), mean 1 (Marsaglia & Tsang 2000 generator).
+  const normal = () => Math.sqrt(-2 * Math.log(rnd() || 1e-12)) * Math.cos(2 * Math.PI * rnd());
+  const gamma = (k: number) => {
+    const d = k - 1 / 3, c = 1 / Math.sqrt(9 * d);
+    for (;;) {
+      const x = normal(), v = (1 + c * x) ** 3;
+      if (v > 0 && Math.log(rnd() || 1e-12) < 0.5 * x * x + d - d * v + d * Math.log(v)) return d * v;
+    }
+  };
+  const w = 300, h = 300, z = new Float64Array(w * h);
+  for (let k = 0; k < z.length; k++) z[k] = 0.05 * (gamma(4.4) / 4.4) * (k % w >= 150 ? 4 : 1);
+  const f = leeFilter(z, w, h, 7, 4.4);
+  let s = 0, s2 = 0, n = 0, zs = 0, zs2 = 0;
+  for (let y = 10; y < h - 10; y++) for (let x = 10; x < 140; x++) {
+    const v = f[y * w + x], u = z[y * w + x];
+    s += v; s2 += v * v; zs += u; zs2 += u * u; n++;
+  }
+  const mean = s / n, cv = Math.sqrt(s2 / n - mean * mean) / mean, cvz = Math.sqrt(zs2 / n - (zs / n) ** 2) / (zs / n);
+  assert.ok(Math.abs(mean / 0.05 - 1) < 0.02, `mean ${mean}`);
+  assert.ok(cv < cvz / 4, `cv ${cv} vs ${cvz}`);
+  let east = 0, m = 0;
+  for (let y = 10; y < h - 10; y++) for (let x = 154; x < 160; x++) (east += f[y * w + x]), m++;
+  assert.ok(Math.abs(east / m / 0.2 - 1) < 0.05, `east of the edge ${east / m}`);
+});
+
+test('Sentinel-1 pair: the 30 ha clearing shows as a VH decrease', async () => {
