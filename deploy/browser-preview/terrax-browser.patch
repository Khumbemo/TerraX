+  // scripts/make_samples.py: river |x − 60 − 0.2y| < 4, town within 22 px of (200, 40), forest elsewhere.
+  let ok = 0;
+  for (let row = 0; row < r.height; row++) for (let col = 0; col < r.width; col++) {
+    const x = col + 0.5, y = row + 0.5;
+    const truth = Math.abs(x - 60 - y * 0.2) < 4 ? 3 : (x - 200) ** 2 + (y - 40) ** 2 < 22 ** 2 ? 1 : 2;
+    ok += +(r.classes[row * r.width + col] === truth);
