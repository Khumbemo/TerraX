diff --git a/src/components/tools/CanopyTool.tsx b/src/components/tools/CanopyTool.tsx
new file mode 100644
index 0000000..eccf17a
--- /dev/null
+++ b/src/components/tools/CanopyTool.tsx
@@ -0,0 +1,409 @@
+import { useState } from 'react';
+import type { Feature, FeatureCollection, Point } from 'geojson';
+import { downloadText } from '../../lib/download';
+import { bboxToLatLng } from '../../lib/geo';
+import { mapImage } from '../../lib/overlay';
+import { unprojector } from '../../lib/patches';
+import { groundGeometry, openGeoTiff, sameGrid, type GeoMeta } from '../../lib/rasterio';
+import { fetchSample } from '../../lib/samples';
+import { fmt } from '../../lib/stats';
+import { useToast } from '../../lib/toast';
+import type { ToolOutput } from '../../lib/tools/registry';
+import { analyzeCanopy, canopyMarkdown, chmFromLas, type CanopyResult } from '../../lib/tools/canopy';
+import { biomassModel, biomassRows, blockHeights, blockSide, calibrateCount, calibratedRow, onGrid, plotCells, plotHeights, plotValues, readPlots, type Biomass, type Calibrated, type PlotGrid } from '../../lib/tools/fieldplots';
+import { parseSurveyFile } from '../../lib/tools/survey';
+import { projector } from '../../lib/zonal';
+import FileDrop from '../FileDrop';
+import RgbaCanvas from '../RgbaCanvas';
+import { Stat } from './ForestLossTool';
+
+interface Props {
+  onOutput: (out: ToolOutput | null) => void;
+}
+
+type Source = 'cloud' | 'dsm' | 'chm';
+const COLORS: [number, number, number][] = [[247, 252, 245], [199, 233, 192], [116, 196, 118], [35, 139, 69], [0, 68, 27]];
+const MAP_TREES = 20_000;
+
+interface Done {
+  name: string;
+  source: string;
+  chm: Float32Array;
+  width: number;
+  height: number;
+  res: CanopyResult;
+  notes: string[];
+  hi: number;
+  trees: FeatureCollection<Point> | null;
+  biomass: (Biomass & { cellSideM: number; blocks: { tch: Float64Array; wb: number; hb: number } }) | null;
+  calibrated: Calibrated | null;
+}
+
+function chmRgba(chm: Float32Array, hi: number): Uint8ClampedArray {
+  const out = new Uint8ClampedArray(chm.length * 4);
+  for (let k = 0; k < chm.length; k++) {
+    const v = chm[k];
+    if (Number.isNaN(v)) continue;
+    const x = Math.min(1, Math.max(0, v / (hi || 1))) * (COLORS.length - 1);
+    const i = Math.min(COLORS.length - 2, Math.floor(x)), f = x - i;
+    out.set([0, 1, 2].map(c => COLORS[i][c] + (COLORS[i + 1][c] - COLORS[i][c]) * f).concat(255), k * 4);
+  }
+  return out;
+}
+
+export default function CanopyTool({ onOutput }: Props) {
+  const notify = useToast();
+  const [source, setSource] = useState<Source>('cloud');
+  const [files, setFiles] = useState<Partial<Record<'cloud' | 'dsm' | 'dtm' | 'chm', File>>>({});
+  const [cell, setCell] = useState('1');
+  const [threshold, setThreshold] = useState('2');
+  const [minTree, setMinTree] = useState('5');
+  const [busy, setBusy] = useState(false);
+  const [done, setDone] = useState<Done | null>(null);
+  const [plots, setPlots] = useState<{ name: string; fc: FeatureCollection } | null>(null);
+  const [countField, setCountField] = useState('');
+  const [agbField, setAgbField] = useState('');
+  const fail = (m: string) => notify(m, 'error');
+
+  const loadPlots = async (f: File) => {
+    try {
+      const { fc } = await parseSurveyFile(f, false);
+      setPlots({ name: f.name, fc });
+      setDone(null);
+      onOutput(null);
+    } catch (err) {
+      fail(err instanceof Error ? err.message : `Could not read ${f.name}.`);
+    }
+  };
+
+  const run = async (src = source, fs = files) => {
+    const thr = Number(threshold), mt = Number(minTree), cs = Number(cell);
+    if (![thr, mt, cs].every(v => Number.isFinite(v) && v > 0)) return fail('Cell size and heights must be positive numbers of metres.');
+    setBusy(true);
+    try {
+      let chm: Float32Array, w: number, h: number, cellM: number, cellArea: (row: number) => number, name: string, sourceText: string;
+      const notes: string[] = [];
+      let toLonLat: ((col: number, row: number) => [number, number]) | null = null;
+      let bounds: ReturnType<typeof bboxToLatLng> = null;
+      let gridMeta: GeoMeta | null = null; // places the full-resolution map tiles
+      let plotGrid: PlotGrid | null = null; // places field plots on the CHM
+      if (src === 'cloud') {
+        const f = fs.cloud;
+        if (!f) throw new Error('Add a LAS or LAZ point cloud first.');
+        const g = await chmFromLas(await f.arrayBuffer(), cs);
+        ({ chm, width: w, height: h } = g);
+        cellM = cs;
+        cellArea = () => cs * cs;
+        name = f.name;
+        sourceText = `${g.points.toLocaleString()} points, ${g.ground.toLocaleString()} ground (class 2), gridded at ${fmt(cs, 3)} m`;
+        notes.push(...g.notes);
+        const bbox: [number, number, number, number] = [g.x0, g.y1 - h * g.cellUnits, g.x0 + w * g.cellUnits, g.y1];
+        const meta = { geographic: false, epsg: g.epsg } as GeoMeta;
+        const un = g.epsg ? unprojector(meta) : null;
+        const fwd = g.epsg ? projector(meta) : null;
+        if (fwd) plotGrid = { width: w, height: h, bbox, project: fwd };
+        if (un) {
+          toLonLat = (c, r) => un(g.x0 + (c + 0.5) * g.cellUnits, g.y1 - (r + 0.5) * g.cellUnits);
+          bounds = bboxToLatLng(bbox, g.epsg);
+          gridMeta = { ...meta, bbox };
+        } else if (g.epsg) notes.push(`EPSG:${g.epsg} cannot be placed on the map in the browser version (supported: WGS84, Web Mercator, WGS84 UTM); the measurements are unaffected.`);
+      } else {
+        const open = async (f: File | undefined, what: string) => {
+          if (!f) throw new Error(`Add the ${what} first.`);
+          return openGeoTiff(f);
+        };
+        const ref = src === 'chm' ? await open(fs.chm, 'canopy height model') : await open(fs.dsm, 'surface model (DSM)');
+        const [g0] = await ref.readBands([0]);
+        ({ width: w, height: h } = g0);
+        if (src === 'chm') {
+          chm = Float32Array.from(g0.data);
+          name = ref.meta.filename;
+          sourceText = 'canopy height raster';
+        } else {
+          const dtm = await open(fs.dtm, 'terrain model (DTM)');
+          if (!sameGrid(ref.meta, dtm.meta)) throw new Error('The DSM and DTM are not on the same grid. Export both with the same extent, cell size and CRS.');
+          const [t0] = await dtm.readBands([0]);
+          chm = new Float32Array(w * h);
+          for (let k = 0; k < chm.length; k++) chm[k] = Number.isNaN(g0.data[k]) || Number.isNaN(t0.data[k]) ? NaN : Math.max(g0.data[k] - t0.data[k], 0);
+          name = `${ref.meta.filename} − ${dtm.meta.filename}`;
+          sourceText = 'DSM − DTM rasters';
+          notes.push('CHM = DSM − DTM, negatives set to 0.');
+        }
+        const geo = groundGeometry(ref.meta, g0);
+        if (!geo) throw new Error('The raster has no ground units the browser version can use (WGS84, Web Mercator or WGS84 UTM).');
+        cellArea = geo.cellArea;
+        const sp = geo.spacing(Math.floor(h / 2));
+        cellM = Math.sqrt(sp.dx * sp.dy);
+        notes.push(geo.note, ...ref.meta.warnings);
+        if (g0.resampleFactor > 1) notes.push('Analysed on a resampled grid; tree tops need the original resolution, so counts are a lower bound.');
+        const un = unprojector(ref.meta);
+        const bb = ref.meta.bbox;
+        if (un && bb) {
+          const cw = (bb[2] - bb[0]) / w, ch = (bb[3] - bb[1]) / h;
+          toLonLat = (c, r) => un(bb[0] + (c + 0.5) * cw, bb[3] - (r + 0.5) * ch);
+        }
+        bounds = ref.meta.latLngBounds;
+        gridMeta = ref.meta;
+        const fwd = projector(ref.meta);
+        if (fwd && bb) plotGrid = { width: w, height: h, bbox: bb, project: fwd };
+      }
+      const res = analyzeCanopy(chm, w, h, cellArea, cellM, thr, mt);
+      notes.push(
+        `Tree tops: local maxima of the CHM (Gaussian σ 0.67 cells) at least ${fmt(mt, 3)} m tall and highest within half the crown width expected for their height, CW = 3.75 − 0.179 H + 0.0124 H² m (Popescu & Wynne 2004). Suppressed trees under taller crowns are missed, so counts in dense stands are a lower bound.`,
+        'Canopy cover is the share of cells at or above the height threshold seen from above; FAO’s forest definition uses trees of at least 5 m and more than 10 % cover.',
+      );
+      let biomass: Done['biomass'] = null;
+      let calibrated: Calibrated | null = null;
+      const plotRows: string[] = [];
+      if (plots) {
+        if (!plotGrid) throw new Error('Field plots need a point cloud or raster with a coordinate reference system the browser version can place them on (WGS84, Web Mercator, UTM or a declared projection).');
+        const fp = readPlots(plots.name, plots.fc, countField, agbField);
+        const keepIdx = fp.feats.map((f, i) => (onGrid(f.geometry, plotGrid!) ? i : -1)).filter(i => i >= 0);
+        if (keepIdx.length < fp.feats.length) notes.push(`${fp.feats.length - keepIdx.length} of ${fp.feats.length} field plots lie outside the canopy height model and were left out.`);
+        const kept = keepIdx.map(i => fp.feats[i]);
+        const cells = kept.map(f => plotCells(f.geometry, plotGrid!));
+        if (fp.agbKey) {
+          const agb = plotValues(fp, fp.agbKey, 'biomass in Mg/ha', false);
+          const b = blockSide(kept, cellM);
+          const blocks = blockHeights(chm, w, h, cellArea, b);
+          const bm = biomassModel(plotHeights(cells, chm), keepIdx.map(i => agb[i]), blocks.tch, blocks.ha);
+          biomass = { ...bm, cellSideM: b * cellM, blocks: { tch: blocks.tch, wb: blocks.wb, hb: blocks.hb } };
+          notes.push(
+            `Biomass: AGB = ${bm.a.toPrecision(3)} × TCH^${bm.b.toFixed(3)} Mg/ha (Asner & Mascaro 2014), fitted on ${bm.plots} field plots by least squares on logs (σ = ${bm.sigmaLog.toFixed(3)}, ` +
+              `back-transformed with Baskerville's correction), where TCH is a plot's mean canopy height gaps included. Leave-one-out RMSE ${bm.looRmse.toFixed(1)} Mg/ha. ` +
+              `Applied to cells of ${(b * cellM).toFixed(0)} m, about the plots' size, since the model only holds at the scale it was fitted at.`,
+            `95 % interval of the total by Monte Carlo (${bm.draws.toLocaleString('en-US')} draws of the model parameters and of a log-scale residual per cell). Cells are treated as independent, so ` +
+              'spatial correlation is ignored and the interval is narrower than the true one. Carbon = 0.47 × biomass (IPCC 2006); CO₂e = carbon × 44/12. Below-ground biomass is not included.',
+          );
+          if (bm.extrapolatedShare > 0.05) notes.push(`${(bm.extrapolatedShare * 100).toFixed(0)} % of the area has a mean canopy height outside the plots' range (${bm.tchRange[0].toFixed(1)}–${bm.tchRange[1].toFixed(1)} m): the model is extrapolated there. Add plots in shorter or taller stands.`);
+          if (bm.plots < 20) notes.push(`With ${bm.plots} plots the model is uncertain; area-based biomass models are usually fitted on 30 or more.`);
+        }
+        if (fp.countKey) {
+          const counts = plotValues(fp, fp.countKey, 'numbers of trees', true);
+          const tops = new Set(res.trees.cells);
+          const detected = cells.map(cs => cs.reduce((n, k) => n + (tops.has(k) ? 1 : 0), 0));
+          const cal = calibrateCount(keepIdx.map(i => counts[i]), detected, res.trees.count, res.areaHa);
+          calibrated = cal;
+          notes.push(
+            `Calibrated count: in ${cal.plots} field plots, ${cal.fieldTrees.toLocaleString('en-US')} trees were counted on the ground and ${cal.detectedInPlots.toLocaleString('en-US')} tree tops detected ` +
+              `(${((cal.detectionRate ?? 0) * 100).toFixed(0)} % detected). The ratio estimator (Cochran 1977, ch. 6) scales the ${res.trees.count.toLocaleString('en-US')} detected trees by ` +
+              `${cal.ratio.toPrecision(3)} to ${Math.round(cal.total).toLocaleString('en-US')}` +
+              (cal.se !== null ? ` (standard error ${Math.round(cal.se).toLocaleString('en-US')})` : '') +
+              '. It assumes the plots were placed at random over the area and counted the same trees (at least the minimum height).' +
+              (cal.plots < 10 ? ` With ${cal.plots} plots the ratio estimate can be biased; use at least 10.` : ''),
+          );
+          plotRows.push(calibratedRow(cal, fmt));
+        }
+        if (biomass) plotRows.push(...biomassRows(biomass, fmt));
+      }
+      let trees: FeatureCollection<Point> | null = null;
+      if (toLonLat) {
+        const feats: Feature<Point>[] = res.trees.cells.map((k, i) => ({ type: 'Feature', properties: { height_m: Math.round(res.trees.heights[i] * 100) / 100 }, geometry: { type: 'Point', coordinates: toLonLat!(k % w, Math.floor(k / w)).map(v => Math.round(v * 1e7) / 1e7) } }));
+        trees = { type: 'FeatureCollection', features: feats };
+        if (feats.length > MAP_TREES) notes.push(`The map shows the ${MAP_TREES.toLocaleString()} tallest of ${feats.length.toLocaleString()} tree tops; the export holds all of them.`);
+      }
+      const finite = Float64Array.from(chm.filter(Number.isFinite)).sort();
