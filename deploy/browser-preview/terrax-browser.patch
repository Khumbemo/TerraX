+/**
+ * Full-resolution tiles of a result grid, drawn in this tab (lib/overlay renderTile) and shown from `minZoom`, where
+ * the 1,024 px picture runs out of detail; Leaflet scales them beyond `maxNativeZoom`.
+ */
+function GridTiles({ tiles, opacity }: { tiles: NonNullable<MapImage['tiles']>; opacity: number }) {
+  const map = useMap();
+  useEffect(() => {
+    const Layer = L.GridLayer.extend({
+      createTile(coords: L.Coords) {
+        const canvas = document.createElement('canvas');
+        canvas.width = canvas.height = 256;
+        canvas.dataset.result = 'tile';
+        const rgba = renderTile(tiles.id, coords.z, coords.x, coords.y);
+        if (rgba) canvas.getContext('2d')?.putImageData(new ImageData(rgba, 256, 256), 0, 0);
+        return canvas;
+      },
+    }) as unknown as new (options: L.GridLayerOptions) => L.GridLayer;
+    const layer = new Layer({ minZoom: tiles.minZoom, maxNativeZoom: tiles.maxNativeZoom, maxZoom: 24, opacity, className: 'pixelated-overlay', zIndex: 300 });
+    layer.addTo(map);
+    return () => void layer.remove();
+  }, [map, tiles, opacity]);
+  return null;
+}
+
+/** The map's zoom, kept in step. */
+function useZoom(): number {
+  const map = useMap();
+  const [zoom, setZoom] = useState(() => map.getZoom());
+  useMapEvents({ zoomend: () => setZoom(map.getZoom()) });
+  return zoom;
+}
+
+/** The result picture, handing over to its full-resolution tiles (when it has them) once zoomed in far enough. */
+function ResultImage({ image, opacity }: { image: MapImage; opacity: number }) {
+  const zoom = useZoom();
+  const tiled = image.tiles && zoom >= image.tiles.minZoom;
+  return (
+    <>
+      {!tiled && <ImageOverlay key={image.url.length + image.label} url={image.url} bounds={image.bounds} opacity={opacity} className="pixelated-overlay" />}
+      {image.tiles && <GridTiles tiles={image.tiles} opacity={opacity} />}
+    </>
+  );
+}
