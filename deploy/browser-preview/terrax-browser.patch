+  const { mapStreams, MAP_STREAM_POINTS } = await import('../src/lib/tools/hydrology');
+  const line = (strahler: number, n: number) => ({ type: 'Feature' as const, properties: { strahler }, geometry: { type: 'LineString' as const, coordinates: Array.from({ length: n }, () => [0, 0]) } });
+  const fc = (...f: ReturnType<typeof line>[]) => ({ type: 'FeatureCollection' as const, features: f });
+  const small = fc(line(1, 10), line(2, 5));
