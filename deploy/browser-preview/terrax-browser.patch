+}
+
+/** Mean canopy height (gaps included: top-of-canopy height, TCH) of each plot's cells; NaN where none is valid. */
+export function plotHeights(cells: number[][], chm: Float32Array): number[] {
+  return cells.map(cs => {
+    let s = 0, n = 0;
+    for (const k of cs) if (Number.isFinite(chm[k])) (s += chm[k]), n++;
+    return n ? s / n : NaN;
+  });
+}
+
+/** Mean CHM and ground area (ha) of b × b blocks; blocks under half covered by valid cells are NaN. */
+export function blockHeights(chm: Float32Array, w: number, h: number, cellArea: (row: number) => number, b: number): { tch: Float64Array; ha: Float64Array; wb: number; hb: number } {
+  const wb = Math.ceil(w / b), hb = Math.ceil(h / b);
+  const tch = new Float64Array(wb * hb).fill(NaN), ha = new Float64Array(wb * hb);
+  for (let i = 0; i < hb; i++) {
+    const rEnd = Math.min(h, (i + 1) * b);
+    const full = (rEnd - i * b) * b;
+    for (let j = 0; j < wb; j++) {
+      let sum = 0, cnt = 0, area = 0;
+      for (let r = i * b; r < rEnd; r++) {
+        const a = cellArea(r);
+        for (let c = j * b; c < Math.min(w, (j + 1) * b); c++) {
+          const v = chm[r * w + c];
+          if (Number.isFinite(v)) (sum += v), cnt++, (area += a);
+        }
+      }
+      ha[i * wb + j] = area / 1e4;
+      if (cnt >= 0.5 * full) tch[i * wb + j] = sum / cnt;
+    }
+  }
+  return { tch, ha, wb, hb };
+}
+
+export interface Calibrated {
+  plots: number;
+  fieldTrees: number;
+  detectedInPlots: number;
+  ratio: number;
+  detectionRate: number | null;
+  total: number;
+  perHa: number | null;
+  se: number | null;
+  ci95: [number, number] | null;
+}
+
+/**
+ * Ratio estimate of the true number of trees from field plots (Cochran 1977, sections 6.2–6.4): R = Σ field / Σ
+ * detected in the plots, total = R × trees detected over the whole area. The variance leaves out the finite-population
+ * correction (plots cover a tiny share of the area); the interval uses Student's t with n − 1 degrees of freedom.
+ */
+export function calibrateCount(field: number[], detected: number[], detectedTotal: number, areaHa?: number | null): Calibrated {
+  const n = field.length;
+  if (!n) throw new Error('No field plot lies on the canopy height model.');
+  if (field.some(v => !(v >= 0) || !Number.isFinite(v))) throw new Error('Field counts must be whole numbers of trees, zero or more.');
+  const sy = field.reduce((a, b) => a + b, 0), sx = detected.reduce((a, b) => a + b, 0);
+  if (sx <= 0) throw new Error('No tree tops were detected inside the field plots, so their counts cannot calibrate the detection. Check that the plots lie on the forest.');
+  const r = sy / sx;
+  const total = r * detectedTotal;
+  const out: Calibrated = { plots: n, fieldTrees: Math.round(sy), detectedInPlots: Math.round(sx), ratio: r, detectionRate: sy ? sx / sy : null, total, perHa: areaHa ? total / areaHa : null, se: null, ci95: null };
+  if (n >= 2) {
+    const xbar = sx / n;
+    const v = field.reduce((a, y, i) => a + (y - r * detected[i]) ** 2, 0) / (n - 1) / (n * xbar * xbar);
+    const se = detectedTotal * Math.sqrt(v);
+    const t = t975(n - 1);
+    out.se = se;
+    out.ci95 = [Math.max(0, total - t * se), total + t * se];
+  }
+  return out;
+}
+
+export interface Biomass {
+  plots: number;
+  a: number;
+  b: number;
+  sigmaLog: number;
+  r2Log: number | null;
+  rmse: number;
+  looRmse: number;
+  tTwoSided: number;
+  areaHa: number;
+  totalMg: number;
+  meanMgHa: number | null;
+  ci95Mg: [number, number];
+  carbonMg: number;
+  co2eMg: number;
+  extrapolatedShare: number;
+  cells: number;
+  draws: number;
+  tchRange: [number, number];
+  cellSideM?: number;
+  /** Estimated AGB (Mg/ha) per block. */
+  cellAgb: Float64Array;
+}
+
+/** Least squares of y on [1, x]: coefficients, residual sum of squares and (XᵀX)⁻¹. */
+function fitLine(x: number[], y: number[]): { b0: number; b1: number; rss: number; inv: [number, number, number] } {
+  const n = x.length;
+  let sx = 0, sxx = 0, sy = 0, sxy = 0;
+  for (let i = 0; i < n; i++) (sx += x[i]), (sxx += x[i] * x[i]), (sy += y[i]), (sxy += x[i] * y[i]);
+  const det = n * sxx - sx * sx;
+  const b1 = (n * sxy - sx * sy) / det, b0 = (sy - b1 * sx) / n;
