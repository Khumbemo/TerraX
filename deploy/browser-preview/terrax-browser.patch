@@ -126,3 +126,38 @@ test('synthetic residential sample: shed grows across the east boundary; fence s
   assert.equal(early.length, 1);
   assert.ok(early[0].depthInside >= 2 && early[0].depthInside <= 3, `2021 depth ${early[0].depthInside}`); // true 2.5 m
 });
+
+test('plot images over the analysis budget are sampled at full resolution around the property', async () => {
+  const { readFileSync } = await import('node:fs');
+  const dir = new URL('../public/data/samples/', import.meta.url);
+  const boundary = { name: 'p', areaM2: 0, geojson: JSON.parse(readFileSync(new URL('plot_boundary_synthetic.geojson', dir), 'utf8')) };
+  // A 2100 × 2100 (4.4 MP) image around the sample plot at 0.1 m; a whole-raster read would coarsen it.
+  const src = await openGeoTiff(new File([readFileSync(new URL('plot_2024-02-08_synthetic.tif', dir))], 'src.tif'));
+  const [sx0, , , sy1] = src.meta.bbox!;
+  const [g] = [await src.readBands([0, 1, 2])];
+  const n = 2100, res = 0.1, e0 = sx0 - 5, n0 = sy1 + 5;
+  const rnd = lcg(7);
+  const data = new Uint8Array(n * n * 3);
+  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) {
+    const sc = Math.floor((e0 + (c + 0.5) * res - sx0) / src.meta.pixelSize![0]), sr = Math.floor((sy1 - (n0 - (r + 0.5) * res)) / src.meta.pixelSize![1]);
+    for (let b = 0; b < 3; b++) {
+      const v = sc >= 0 && sr >= 0 && sc < g[b].width && sr < g[b].height ? g[b].data[sr * g[b].width + sc] : 60;
+      data[(r * n + c) * 3 + b] = Math.max(0, Math.min(255, Math.round(v + (rnd() - 0.5) * 30)));
+    }
+  }
+  const buf = await writeArrayBuffer(data, { width: n, height: n, SamplesPerPixel: 3, BitsPerSample: [8, 8, 8], SampleFormat: [1, 1, 1], PlanarConfiguration: 1, ModelPixelScale: [res, res, 0], ModelTiepoint: [0, 0, 0, e0, n0, 0], GTModelTypeGeoKey: 1, GTRasterTypeGeoKey: 1, ProjectedCSTypeGeoKey: 32646 });
+  const big = await openGeoTiff(new File([buf], 'big.tif'));
+  const before = await openGeoTiff(new File([readFileSync(new URL('plot_2019-02-10_synthetic.tif', dir))], 'before.tif'));
+  // Reference: the same file held at full resolution, sampled without window reads.
+  const planes = [0, 1, 2].map(b => Float32Array.from({ length: n * n }, (_, k) => data[k * 3 + b]));
+  const native = { meta: big.meta, readBands: async (ix: number[]) => ix.map(i => ({ width: n, height: n, data: planes[i], resampleFactor: 1 })) };
+  const got = await prepareGeoStack([{ raster: before, label: 'a', date: null }, { raster: big, label: 'b', date: null }], boundary, 15);
+  const ref = await prepareGeoStack([{ raster: before, label: 'a', date: null }, { raster: native, label: 'b', date: null }], boundary, 15);
+  assert.equal(got.cellM, 0.1);
+  for (let b = 0; b < 3; b++) assert.deepEqual(got.layers[1].rgb[b], ref.layers[1].rgb[b]);
+  // Decimated windows keep exactly every step-th pixel.
+  const full = await big.readWindow!([1], 7, 5, 1007, 905);
+  const thin = await big.readWindow!([1], 7, 5, 1007, 905, full.width * full.height / 10);
+  assert.equal(thin.step, 4);
+  for (let i = 0; i < thin.height; i++) for (let j = 0; j < thin.width; j++) assert.equal(thin.data[0][i * thin.width + j], full.data[0][i * 4 * full.width + j * 4]);
+});
diff --git a/tests/fieldplots.test.ts b/tests/fieldplots.test.ts
new file mode 100644
index 0000000..6c496ed
--- /dev/null
+++ b/tests/fieldplots.test.ts
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { biomassModel, blockHeights, calibrateCount, onGrid, plotCells } from '../src/lib/tools/fieldplots';
+
+const F = JSON.parse(readFileSync(new URL('./fixtures/fieldplots_parity.json', import.meta.url), 'utf8'));
+const num = (a: (number | null)[]) => a.map(v => (v === null ? NaN : v));
+const close = (a: number, b: number, rel: number, what: string) => assert.ok(Math.abs(a - b) <= rel * Math.max(1, Math.abs(b)), `${what}: ${a} vs ${b}`);
+
+test('plot-sized blocks match the Python server (ragged edges, gaps, a corner without data)', () => {
+  const chm = Float32Array.from(num(F.chm));
+  const r = blockHeights(chm, F.w, F.h, row => F.cellArea[row], F.b);
+  const want = num(F.blockTch);
+  assert.equal(r.tch.length, want.length);
+  want.forEach((v: number, k: number) => (Number.isNaN(v) ? assert.ok(Number.isNaN(r.tch[k]), `block ${k}`) : close(r.tch[k], v, 1e-5, `block ${k}`)));
+  F.blockHa.forEach((v: number, k: number) => close(r.ha[k], v, 1e-9, `block area ${k}`));
+});
+
+test('biomass from field plots: the server’s fit, totals and leave-one-out error; its Monte Carlo interval within sampling error', () => {
+  const b = biomassModel(num(F.tch), F.agb, Float64Array.from(num(F.blockTch)), Float64Array.from(F.blockHa));
+  const s = F.biomass;
+  assert.equal(b.plots, s.plots);
+  for (const k of ['a', 'b', 'sigmaLog', 'r2Log', 'rmse', 'looRmse', 'tTwoSided', 'areaHa', 'totalMg', 'meanMgHa', 'carbonMg', 'co2eMg', 'extrapolatedShare'] as const) close(b[k] as number, s[k], 1e-9, k);
+  assert.equal(b.cells, s.cells);
+  assert.deepEqual(b.tchRange, s.tchRange);
+  F.cellAgb.forEach((v: number, k: number) => close(b.cellAgb[k], v, 1e-9, `block AGB ${k}`));
+  // 2,000 draws: the 2.5 % and 97.5 % points move by about 1 % of the total between random streams.
+  close(b.ci95Mg[0], s.ci95Mg[0], 0.02, 'lower 95 % bound');
+  close(b.ci95Mg[1], s.ci95Mg[1], 0.02, 'upper 95 % bound');
+  assert.ok(b.ci95Mg[0] < b.totalMg && b.totalMg < b.ci95Mg[1]);
+  assert.throws(() => biomassModel([10, 12, NaN, 0], [50, 60, 70, 80], new Float64Array(1), new Float64Array(1)), /at least 5 field plots/);
+});
+
+test('calibrated tree count (ratio estimator): the server’s total, standard error and interval', () => {
+  const c = calibrateCount(F.field, F.detected, 250, 16);
+  const s = F.calibrated;
+  for (const k of ['ratio', 'total', 'perHa', 'se', 'detectionRate'] as const) close(c[k] as number, s[k], 1e-12, k);
+  close(c.ci95![0], s.ci95[0], 1e-9, 'ci low');
+  close(c.ci95![1], s.ci95[1], 1e-9, 'ci high');
+  // Cochran's worked case from the server test: counts 2, 1, 3 over single detected tops; 25 detected in all.
+  const w = calibrateCount([2, 1, 3], [1, 1, 1], 25, 2);
+  assert.equal(w.total, 50);
+  assert.equal(w.perHa, 25);
+  close(w.se!, 25 * Math.sqrt(1 / 3), 1e-12, 'se');
+  close(w.ci95![1], 50 + 4.302653 * 25 * Math.sqrt(1 / 3), 1e-6, 'upper');
+  assert.equal(calibrateCount([4], [2], 10).se, null);
+  assert.throws(() => calibrateCount([3, 4], [0, 0], 10), /No tree tops were detected/);
+});
+
+test('plot cells are the cell centres inside the polygon, holes left out', () => {
+  const grid = { width: 10, height: 10, bbox: [0, 0, 10, 10] as [number, number, number, number], project: (x: number, y: number) => [x, y] as [number, number] };
+  const square = { type: 'Polygon' as const, coordinates: [[[2, 2], [6, 2], [6, 6], [2, 6], [2, 2]], [[3, 3], [4, 3], [4, 4], [3, 4], [3, 3]]] };
+  const cells = plotCells(square, grid);
+  assert.equal(cells.length, 16 - 1); // 4 × 4 centres, one in the hole
+  assert.ok(!cells.includes(6 * 10 + 3)); // row 6 (y 3.5), column 3 (x 3.5): the hole
+  assert.ok(onGrid(square, grid));
+  assert.ok(!onGrid({ type: 'Polygon', coordinates: [[[8, 8], [12, 8], [12, 12], [8, 8]]] }, grid));
+  // Along the edge, a projection round trip's sub-millimetre error does not drop the plot.
+  assert.ok(onGrid({ type: 'Polygon', coordinates: [[[0, 0], [10.0000001, 0], [10.0000001, -0.0000001], [0, 0]]] }, grid));
+});
