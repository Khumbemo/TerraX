+// Field plots on a canopy height model: a calibrated tree count (ratio estimator) and above-ground biomass from
+// top-of-canopy height (area-based approach). The same estimators as the Python server (terrax/processing/canopy.py,
+// terrax/tools/canopy.py); only the Monte Carlo draws use this file's own random numbers.
+import type { Feature, FeatureCollection, MultiPolygon, Polygon, Position } from 'geojson';
+import { t975 } from './carbon';
+import { rng } from './kmeans';
+import { polygonAreaM2 } from './survey';
+
+export const COUNT_FIELDS = ['trees', 'tree_count', 'field_count', 'count', 'stems', 'n'];
+export const AGB_FIELDS = ['agb', 'agb_mg_ha', 'agb_t_ha', 'biomass', 'biomass_mg_ha', 'biomass_t_ha'];
