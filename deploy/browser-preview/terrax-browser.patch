+// Canopy height from a point cloud (LAS/LAZ) or from surface and terrain models.
+//  • DSM: highest first return per cell; DTM: lowest ground return (ASPRS class 2), empty cells filled by
+//    linear interpolation on a Delaunay triangulation of the ground cells (nearest ground cell outside it).
+//    CHM = DSM − DTM, negatives set to 0.
+//  • Canopy cover: share of cells at or above a height threshold (2 m by default; FAO's forest definition uses 5 m).
+//  • Tree tops: local maxima of the lightly smoothed CHM, each the highest cell within half its expected crown
+//    width CW = 3.75105 − 0.17919 H + 0.01241 H² (Popescu & Wynne 2004). A lower bound in dense stands.
+import Delaunator from 'delaunator';
+import { fmt } from '../stats';
+
+export const HEIGHT_CLASSES: [number, number][] = [[0, 2], [2, 5], [5, 10], [10, 20], [20, 30], [30, Infinity]];
+
+export interface LasHeader {
+  version: string;
+  pointFormat: number;
+  compressed: boolean;
+  recordLength: number;
+  count: number;
+  dataOffset: number;
+  scale: [number, number, number];
+  offset: [number, number, number];
+  min: [number, number, number];
+  max: [number, number, number];
+  epsg: number | null;
+  /** Metres per horizontal (and vertical) unit, from the CRS (1 when unknown). */
+  unit: number;
+  crsNote: string;
+}
+
+const cstr = (b: Uint8Array) => new TextDecoder().decode(b.subarray(0, b.indexOf(0) >= 0 ? b.indexOf(0) : b.length));
+
+/** Reads the LAS/LAZ public header and its CRS records (GeoTIFF keys or LAS 1.4 WKT). */
+export function parseLasHeader(buf: ArrayBuffer): LasHeader {
+  const v = new DataView(buf), u8 = new Uint8Array(buf);
+  if (cstr(u8.subarray(0, 4)) !== 'LASF') throw new Error('This is not a LAS or LAZ file (no LASF signature).');
+  const major = v.getUint8(24), minor = v.getUint8(25);
+  const headerSize = v.getUint16(94, true), dataOffset = v.getUint32(96, true), nVlr = v.getUint32(100, true);
+  const fmtByte = v.getUint8(104);
+  const pointFormat = fmtByte & 0x3f, compressed = (fmtByte & 0xc0) !== 0;
+  const recordLength = v.getUint16(105, true);
+  let count = v.getUint32(107, true);
+  if (major === 1 && minor >= 4 && headerSize >= 375) count = Number(v.getBigUint64(247, true)) || count;
+  const d = (o: number) => v.getFloat64(o, true);
+  const header: LasHeader = {
+    version: `${major}.${minor}`, pointFormat, compressed, recordLength, count, dataOffset,
+    scale: [d(131), d(139), d(147)], offset: [d(155), d(163), d(171)],
+    max: [d(179), d(195), d(211)], min: [d(187), d(203), d(219)],
+    epsg: null, unit: 1, crsNote: 'The point cloud declares no CRS: coordinates were taken as metres and it cannot be placed on the map.',
+  };
+  let p = headerSize;
+  for (let i = 0; i < nVlr && p + 54 <= buf.byteLength; i++) {
+    const user = cstr(u8.subarray(p + 2, p + 18)), id = v.getUint16(p + 18, true), len = v.getUint16(p + 20, true);
+    const body = p + 54;
+    if (user === 'LASF_Projection' && id === 34735) {
+      // GeoKeyDirectory: header of 4 shorts, then entries (key, location, count, value).
+      const keys = v.getUint16(body + 6, true);
+      for (let k = 0; k < keys; k++) {
+        const e = body + 8 + k * 8, key = v.getUint16(e, true), val = v.getUint16(e + 6, true);
+        if (key === 3072 || (key === 2048 && header.epsg === null)) header.epsg = val; // projected, else geographic CRS
+        if (key === 3076 && val === 9002) header.unit = 0.3048; // ProjLinearUnits: foot
+        if (key === 3076 && val === 9003) header.unit = 1200 / 3937; // US survey foot
+      }
+    }
+    if (user === 'LASF_Projection' && id === 2112) {
+      const wkt = cstr(u8.subarray(body, body + len));
+      const ids = [...wkt.matchAll(/(?:AUTHORITY\["EPSG",\s*"?|ID\["EPSG",\s*)(\d+)/g)];
+      if (ids.length) header.epsg = Number(ids[ids.length - 1][1]); // the outermost CRS's id comes last
+      if (/US survey foot/i.test(wkt)) header.unit = 1200 / 3937;
+      else if (/LENGTHUNIT\["foot"|UNIT\["foot"/i.test(wkt)) header.unit = 0.3048;
+      if (/GEOGCRS\[|^GEOGCS\[/.test(wkt.trim())) header.epsg = header.epsg ?? 4326;
+    }
+    p = body + len;
+  }
+  if (header.epsg) header.crsNote = `CRS EPSG:${header.epsg}${header.unit !== 1 ? ' (feet; heights converted to metres)' : ''}.`;
+  return header;
+}
+
+/** Calls fn(x, y, z, firstReturn, classification) for every point (file units), decompressing LAZ with laz-perf. */
+export async function forEachPoint(buf: ArrayBuffer, h: LasHeader, fn: (x: number, y: number, z: number, first: boolean, cls: number) => void): Promise<boolean> {
+  const modern = h.pointFormat >= 6;
+  const read = (v: DataView, o: number) => {
+    const x = v.getInt32(o, true) * h.scale[0] + h.offset[0], y = v.getInt32(o + 4, true) * h.scale[1] + h.offset[1], z = v.getInt32(o + 8, true) * h.scale[2] + h.offset[2];
+    const ret = modern ? v.getUint8(o + 14) & 0x0f : v.getUint8(o + 14) & 0x07;
+    const cls = modern ? v.getUint8(o + 16) : v.getUint8(o + 15) & 0x1f;
+    fn(x, y, z, ret <= 1, cls); // return number 0 (unset) counts as first
+  };
+  if (!h.compressed) {
+    const v = new DataView(buf);
+    for (let i = 0; i < h.count; i++) read(v, h.dataOffset + i * h.recordLength);
+    return true;
+  }
+  const { createLazPerf } = await import('laz-perf');
+  let lp: Awaited<ReturnType<typeof createLazPerf>>;
+  if (typeof window === 'undefined') lp = await createLazPerf(); // Node (tests): the package loads its own .wasm
+  else {
+    // The browser build embeds the WebAssembly, so a single-file page needs no extra request.
+    const wasm = (await import('laz-perf/lib/web/laz-perf.wasm?base64')).default;
+    const bin = atob(wasm);
+    const wasmBinary = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) wasmBinary[i] = bin.charCodeAt(i);
+    lp = await createLazPerf({ wasmBinary } as never);
+  }
+  const file = lp._malloc(buf.byteLength);
+  const point = lp._malloc(h.recordLength);
+  const zip = new lp.LASZip();
+  try {
+    lp.HEAPU8.set(new Uint8Array(buf), file);
+    zip.open(file, buf.byteLength);
+    for (let i = 0; i < h.count; i++) {
+      zip.getPoint(point);
+      read(new DataView(lp.HEAPU8.buffer, point, h.recordLength), 0);
+    }
+  } finally {
+    zip.delete();
+    lp._free(point);
+    lp._free(file);
+  }
+  return true;
+}
+
+export interface ChmGrid {
+  chm: Float32Array;
+  width: number;
+  height: number;
+  /** Cell size in metres and in file units; origin (west, north) in file units. */
+  cell: number;
+  cellUnits: number;
+  x0: number;
+  y1: number;
+  epsg: number | null;
+  points: number;
+  ground: number;
+  filled: number;
+  notes: string[];
+}
+
+/** Linear interpolation on a Delaunay triangulation of the known cells; cells outside it take the nearest known cell (grid distance). */
+export function fillHoles(z: Float64Array, w: number, h: number): number {
+  const known: number[] = [];
+  let holes = 0;
+  for (let k = 0; k < z.length; k++) (Number.isNaN(z[k]) ? holes++ : known.push(k));
+  if (!holes || known.length < 3) return holes;
+  const coords = new Float64Array(known.length * 2);
+  known.forEach((k, i) => {
+    coords[2 * i] = (k % w) + 0.5;
+    coords[2 * i + 1] = Math.floor(k / w) + 0.5;
+  });
+  const t = new Delaunator(coords).triangles;
+  const out = z.slice();
+  for (let i = 0; i < t.length; i += 3) {
+    const [a, b, c] = [t[i], t[i + 1], t[i + 2]];
+    const ax = coords[2 * a], ay = coords[2 * a + 1], bx = coords[2 * b], by = coords[2 * b + 1], cx = coords[2 * c], cy = coords[2 * c + 1];
+    const det = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy);
+    if (det === 0) continue;
+    const c0 = Math.max(0, Math.floor(Math.min(ax, bx, cx))), c1 = Math.min(w - 1, Math.ceil(Math.max(ax, bx, cx)));
+    const r0 = Math.max(0, Math.floor(Math.min(ay, by, cy))), r1 = Math.min(h - 1, Math.ceil(Math.max(ay, by, cy)));
+    for (let r = r0; r <= r1; r++) for (let cc = c0; cc <= c1; cc++) {
+      const k = r * w + cc;
+      if (!Number.isNaN(z[k]) || !Number.isNaN(out[k])) continue;
+      const px = cc + 0.5, py = r + 0.5;
+      const l1 = ((by - cy) * (px - cx) + (cx - bx) * (py - cy)) / det, l2 = ((cy - ay) * (px - cx) + (ax - cx) * (py - cy)) / det, l3 = 1 - l1 - l2;
+      if (l1 < -1e-9 || l2 < -1e-9 || l3 < -1e-9) continue;
+      out[k] = l1 * z[known[a]] + l2 * z[known[b]] + l3 * z[known[c]];
+    }
+  }
+  // Outside the triangulation: nearest filled cell by breadth-first search (8-connected).
+  const queue: number[] = [];
+  for (let k = 0; k < out.length; k++) if (!Number.isNaN(out[k])) queue.push(k);
+  for (let qi = 0; qi < queue.length; qi++) {
+    const k = queue[qi], r = Math.floor(k / w), c = k % w;
+    for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++) {
+      const rr = r + dr, cc = c + dc;
+      if (rr < 0 || cc < 0 || rr >= h || cc >= w) continue;
+      const m = rr * w + cc;
+      if (Number.isNaN(out[m])) (out[m] = out[k]), queue.push(m);
+    }
+  }
+  z.set(out);
+  return holes;
+}
+
+export async function chmFromLas(buf: ArrayBuffer, cellM = 1): Promise<ChmGrid> {
+  if (!(cellM >= 0.1 && cellM <= 50)) throw new Error('Choose a cell size between 0.1 and 50 m.');
+  const hd = parseLasHeader(buf);
+  if (hd.epsg === 4326 || (hd.epsg !== null && hd.epsg >= 4000 && hd.epsg < 5000)) throw new Error('The point cloud is in longitude/latitude. Reproject it to a projected CRS in metres or feet (for example UTM) first.');
+  const c = cellM / hd.unit;
+  const [x0, , ] = hd.min, y1 = hd.max[1];
+  const w = Math.max(1, Math.ceil((hd.max[0] - x0) / c)), h = Math.max(1, Math.ceil((y1 - hd.min[1]) / c));
+  if (w * h > 25_000_000) throw new Error(`A ${fmt(cellM, 3)} m grid over this point cloud would have ${(w * h).toLocaleString()} cells; choose a larger cell size (the browser keeps the grid in memory).`);
+  const dsm = new Float64Array(w * h).fill(NaN), dtm = new Float64Array(w * h).fill(NaN);
+  let points = 0, ground = 0;
+  await forEachPoint(buf, hd, (x, y, z, first, cls) => {
+    points++;
+    const ix = Math.min(w - 1, Math.floor((x - x0) / c)), iy = Math.min(h - 1, Math.floor((y1 - y) / c));
+    if (ix < 0 || iy < 0) return;
+    const k = iy * w + ix;
+    if (first && !(dsm[k] >= z)) dsm[k] = z;
+    if (cls === 2) {
+      ground++;
+      if (!(dtm[k] <= z)) dtm[k] = z;
+    }
+  });
+  if (!ground) throw new Error('The point cloud has no ground points (ASPRS class 2). Classify ground first (for example with PDAL’s SMRF or lasground), then load it again.');
+  const filled = fillHoles(dtm, w, h);
+  const chm = new Float32Array(w * h);
+  for (let k = 0; k < chm.length; k++) chm[k] = Number.isNaN(dsm[k]) || Number.isNaN(dtm[k]) ? NaN : Math.max(dsm[k] - dtm[k], 0) * hd.unit;
+  return {
+    chm, width: w, height: h, cell: cellM, cellUnits: c, x0, y1, epsg: hd.epsg, points, ground, filled,
+    notes: [
+      `DSM: highest first return per ${fmt(cellM, 3)} m cell; DTM: lowest ground return, ${filled.toLocaleString()} empty cells filled from a TIN of ground cells (nearest outside it). CHM = DSM − DTM, negatives set to 0.`,
+      hd.crsNote,
+    ],
+  };
+}
+
+/** Separable Gaussian (σ in cells, truncated at 4σ) with scipy's "reflect" edges (d c b a | a b c d). */
+export function gaussianSmooth(z: Float64Array, w: number, h: number, sigma: number): Float64Array {
+  const r = Math.floor(4 * sigma + 0.5);
+  const kern = Array.from({ length: 2 * r + 1 }, (_, i) => Math.exp(-0.5 * ((i - r) / sigma) ** 2));
+  const sum = kern.reduce((a, b) => a + b, 0);
+  for (let i = 0; i < kern.length; i++) kern[i] /= sum;
+  const refl = (i: number, n: number) => {
+    const p = 2 * n;
+    let j = ((i % p) + p) % p;
+    if (j >= n) j = p - 1 - j;
+    return j;
+  };
+  const tmp = new Float64Array(z.length), out = new Float64Array(z.length);
+  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
+    let s = 0;
