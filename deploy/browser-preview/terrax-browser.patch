+  for (let i = 0; i < n; i++) rss += (y[i] - b0 - b1 * x[i]) ** 2;
+  return { b0, b1, rss, inv: [sxx / det, -sx / det, n / det] }; // (XᵀX)⁻¹ = [[i00, i01], [i01, i11]]
+}
+
+/** Standard normal draws (Box–Muller) from a seeded uniform generator. */
+function normals(seed: number): () => number {
+  const u = rng(seed);
+  let spare: number | null = null;
+  return () => {
+    if (spare !== null) {
+      const s = spare;
+      spare = null;
+      return s;
+    }
+    let a = 0;
+    while (a <= 1e-300) a = u();
+    const r = Math.sqrt(-2 * Math.log(a)), th = 2 * Math.PI * u();
+    spare = r * Math.sin(th);
+    return r * Math.cos(th);
+  };
