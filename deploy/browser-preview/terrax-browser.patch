+// Per-pixel disturbance dating in a multi-date image series: one abrupt drop (a level shift) on a linear trend.
+//
+// For each pixel with dates tᵢ and values yᵢ (NaN = cloud-masked or missing), two models are fitted by least squares
+// on its valid dates:
+//
+//   M0:  y = a + b·t                         (no break)
+//   M1:  y = a + b·t + c·[t ≥ t_k]           (a level shift c between the dates t_(k−1) and t_k)
+//
+// M1 is the single-break "trend + break" model of BFAST (Verbesselt et al. 2010) with a common slope. Every k that
+// leaves at least two valid dates on each side is tried and the least residual sum of squares kept. The break date is
+// itself estimated, so it counts as a parameter: the lower Bayesian information criterion (Schwarz 1978) wins,
+//
+//   BIC0 = n·ln(RSS0/n) + 2·ln n,    BIC1 = n·ln(RSS1/n) + 4·ln n,
+//
+// and a pixel is disturbed when M1 wins and the shift is a drop of at least `minDrop`. The same arithmetic as the
+// Python server (terrax/processing/breaks.py), pixel by pixel instead of on whole arrays.
+
+/** The fewest valid dates a pixel needs: three parameters plus two degrees of freedom. */
+export const MIN_DATES = 5;
+
+export interface BreakFit {
+  /** Index of the first valid date after the drop (−1: no disturbance). */
+  after: Int32Array;
+  /** Index of the last valid date before the drop (−1: no disturbance). */
+  before: Int32Array;
+  /** The shift c (NaN: no disturbance). */
+  shift: Float32Array;
+  /** Valid dates per pixel. */
+  valid: Uint8Array;
+}
+
+/**
+ * Fits every pixel of `values` (date-major: values[d][p], NaN = missing) at times `t` (decimal years).
+ */
+export function fitBreaks(t: number[], values: ArrayLike<number>[], minDrop: number): BreakFit {
+  const nd = t.length;
+  const mean = t.reduce((a, b) => a + b, 0) / nd;
+  const tc = t.map(x => x - mean); // centred, for well-conditioned normal equations
+  const npx = values[0]?.length ?? 0;
+  const out: BreakFit = { after: new Int32Array(npx).fill(-1), before: new Int32Array(npx).fill(-1), shift: new Float32Array(npx).fill(NaN), valid: new Uint8Array(npx) };
+  const w = new Uint8Array(nd);
+  const y = new Float64Array(nd);
+  const afterN = new Float64Array(nd + 1);
+  for (let p = 0; p < npx; p++) {
+    let nv = 0, st = 0, stt = 0, sy = 0, sty = 0, syy = 0;
+    for (let d = 0; d < nd; d++) {
+      const v = values[d][p];
+      const ok = Number.isFinite(v);
+      w[d] = ok ? 1 : 0;
+      y[d] = ok ? v : 0;
+      if (ok) {
+        nv++;
+        st += tc[d];
+        stt += tc[d] * tc[d];
+        sy += v;
+        sty += v * tc[d];
+        syy += v * v;
+      }
+    }
+    out.valid[p] = nv;
+    const det0 = nv * stt - st * st;
+    if (!(nv >= MIN_DATES && det0 > 1e-12)) continue;
+    const a0 = (stt * sy - st * sty) / det0;
+    const b0 = (nv * sty - st * sy) / det0;
+    const rss0 = Math.max(syy - a0 * sy - b0 * sty, 0);
+    afterN[nd] = 0;
+    for (let d = nd - 1; d >= 0; d--) afterN[d] = afterN[d + 1] + w[d];
+    let bestRss = Infinity, bestK = -1, bestC = NaN;
+    for (let k = 1; k < nd; k++) {
+      const ns = afterN[k];
+      if (!(ns >= 2 && nv - ns >= 2)) continue;
+      let sts = 0, sys = 0;
+      for (let d = k; d < nd; d++) {
+        if (!w[d]) continue;
+        sts += tc[d];
+        sys += y[d];
+      }
+      // Normal equations [[n, St, Ns], [St, Stt, Sts], [Ns, Sts, Ns]] β = [Sy, Sty, Sys], by Cramer's rule.
+      const a11 = nv, a12 = st, a13 = ns, a22 = stt, a23 = sts, a33 = ns;
+      const c11 = a22 * a33 - a23 * a23;
+      const c12 = a13 * a23 - a12 * a33;
+      const c13 = a12 * a23 - a13 * a22;
+      const det = a11 * c11 + a12 * c12 + a13 * c13;
+      if (!(Math.abs(det) > 1e-10)) continue;
+      const c22 = a11 * a33 - a13 * a13;
+      const c23 = a12 * a13 - a11 * a23;
+      const c33 = a11 * a22 - a12 * a12;
+      const b1 = (c11 * sy + c12 * sty + c13 * sys) / det;
+      const b2 = (c12 * sy + c22 * sty + c23 * sys) / det;
+      const b3 = (c13 * sy + c23 * sty + c33 * sys) / det;
+      const rss = Math.max(syy - (b1 * sy + b2 * sty + b3 * sys), 0);
+      if (rss < bestRss) {
+        bestRss = rss;
+        bestK = k;
+        bestC = b3;
+      }
+    }
+    if (bestK < 0) continue;
+    const floor = 1e-10 * nv; // a perfect fit would give ln 0
+    const bic0 = nv * Math.log(Math.max(rss0, floor) / nv) + 2 * Math.log(nv);
+    const bic1 = nv * Math.log(Math.max(bestRss, floor) / nv) + 4 * Math.log(nv);
+    if (!(bic1 < bic0 && bestC <= -minDrop)) continue;
+    let a = -1, b = -1;
+    for (let d = bestK; d < nd; d++) if (w[d]) { a = d; break; }
+    for (let d = bestK - 1; d >= 0; d--) if (w[d]) { b = d; break; }
+    out.after[p] = a;
+    out.before[p] = b;
+    out.shift[p] = bestC;
+  }
+  return out;
+}
