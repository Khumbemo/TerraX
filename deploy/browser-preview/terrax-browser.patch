+  await expect(page.locator('.stat', { hasText: 'Tree tops' })).toContainText('25', { timeout: 60_000 });
+  await expect(page.locator('.stat', { hasText: 'Canopy cover' })).toContainText('13.8 %');
+  await expect(page.locator('.report-card')).toContainText('Popescu & Wynne');
