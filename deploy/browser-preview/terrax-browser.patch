+  const df = n - 2, s = Math.sqrt(s2);
+  const totals = new Float64Array(draws);
+  for (let d = 0; d < draws; d++) {
+    let chi = 0;
+    for (let q = 0; q < df; q++) chi += z() ** 2; // χ² with n − 2 degrees of freedom
+    const scale = Math.sqrt(df / chi);
+    const z0 = z() * scale, z1 = z() * scale;
