@@ -0,0 +1,68 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { allocate, assess, stratifiedSample } from '../src/lib/tools/accuracy';
+import { fitForest, predictForest } from '../src/lib/tools/randomforest';
+
+test('Olofsson et al. (2014) worked example: areas, user’s, producer’s and overall accuracy', () => {
+  const counts = [[66, 0, 5, 4], [0, 55, 8, 12], [1, 0, 153, 11], [2, 1, 9, 313]];
+  const px = [200_000, 150_000, 3_200_000, 6_450_000];
+  const r = assess(counts, px.map(p => p * 0.09), ['Deforestation', 'Forest gain', 'Stable forest', 'Stable non-forest']);
+  const published: [number, number][] = [[21_158, 6_158], [11_686, 3_756], [285_770, 15_510], [581_386, 16_282]];
+  r.classes.forEach((c, i) => {
+    assert.ok(Math.abs(c.area - published[i][0]) <= 1, `${c.label} area ${c.area}`);
+    assert.ok(Math.abs(c.areaCi! - published[i][1]) <= 2, `${c.label} CI ${c.areaCi}`);
+  });
+  assert.ok(Math.abs(r.overallAccuracy - 0.95) < 0.005 && Math.abs(r.overallCi! - 0.02) < 0.005);
+  assert.ok(Math.abs(r.classes[0].userAccuracy! - 0.88) < 0.005 && Math.abs(r.classes[0].userCi! - 0.07) < 0.005);
+  assert.ok(Math.abs(r.classes[0].producerAccuracy! - 0.75) < 0.005);
+});
+
+test('allocation and stratified sampling', () => {
+  const sizes = allocate([700, 200, 100], 300, 50);
+  assert.deepEqual(sizes.reduce((a, b) => a + b, 0), 300);
+  assert.ok(sizes.every(s => s >= 50));
+  const map = new Uint8Array(1000).map((_, k) => (k < 700 ? 1 : k < 900 ? 2 : 3));
+  const pts = stratifiedSample(map, [1, 2, 3], sizes, 3);
+  assert.equal(pts.length, 300);
+  assert.equal(new Set(pts.map(p => p.cell)).size, 300);
+  assert.ok(pts.every(p => map[p.cell] === p.cls));
+  // A class smaller than its allocation gives all its cells, as on the server.
+  assert.equal(stratifiedSample(map, [3], [150], 3).length, 100);
+});
+
+test('random forest separates learnable classes', () => {
+  let s = 3;
+  const r = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 2 ** 32);
+  const n = 3000, d = 3, X = new Float64Array(n * d), y = new Int32Array(n);
+  for (let i = 0; i < n; i++) {
+    for (let a = 0; a < d; a++) X[i * d + a] = r();
+    y[i] = X[i * d] > 0.6 ? 2 : X[i * d + 1] > 0.5 ? 1 : 0;
+  }
+  const f = fitForest(X, y, d, 3, 30, 7);
+  const Q = new Float64Array(2000 * d).map(() => r());
+  const p = predictForest(f, Q, 2000);
+  let ok = 0;
+  for (let i = 0; i < 2000; i++) ok += +(p[i] === (Q[i * d] > 0.6 ? 2 : Q[i * d + 1] > 0.5 ? 1 : 0));
+  assert.ok(ok / 2000 > 0.97, `accuracy ${ok / 2000}`);
+});
+
+test('supervised land cover on the sample scene matches its true geometry', async () => {
+  const { readFileSync } = await import('node:fs');
+  const { openGeoTiff } = await import('../src/lib/rasterio');
+  const { classifySupervised } = await import('../src/lib/tools/landcover');
+  const dir = new URL('../public/data/samples/', import.meta.url);
+  const raster = await openGeoTiff(new File([readFileSync(new URL('satellite_4band_synthetic.tif', dir))], 'scene.tif'));
+  const training = JSON.parse(readFileSync(new URL('landcover_training_synthetic.geojson', dir), 'utf8'));
+  const r = await classifySupervised(raster, { bands: [0, 1, 2, 3], training, roles: { red: 2, nir: 3 } });
+  assert.deepEqual(r.labels, ['Built-up', 'Forest', 'Water']);
+  assert.equal(r.validation?.folds, 2);
+  assert.ok(r.validation!.overall > 0.95);
+  // scripts/make_samples.py: river |x − 60 − 0.2y| < 4, town within 22 px of (200, 40), forest elsewhere.
+  let ok = 0;
+  for (let row = 0; row < r.height; row++) for (let col = 0; col < r.width; col++) {
+    const x = col + 0.5, y = row + 0.5;
+    const truth = Math.abs(x - 60 - y * 0.2) < 4 ? 3 : (x - 200) ** 2 + (y - 40) ** 2 < 22 ** 2 ? 1 : 2;
+    ok += +(r.classes[row * r.width + col] === truth);
+  }
+  assert.ok(ok / (r.width * r.height) > 0.95, `agreement ${ok / (r.width * r.height)}`);
+});
