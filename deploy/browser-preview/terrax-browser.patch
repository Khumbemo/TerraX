+
+export function plotValues(p: FieldPlots, key: string, what: string, whole: boolean): number[] {
+  return p.feats.map(f => {
+    const v = (f.properties ?? {})[key];
+    if (v === null || v === undefined || v === '') throw new Error(`A plot has no “${key}”; give every plot ${what}.`);
+    const num = Number(v);
+    if (typeof v === 'boolean' || Number.isNaN(num)) throw new Error(`A plot's “${key}” is “${v}”, not ${what}.`);
+    if (!Number.isFinite(num) || num < 0 || (whole && !Number.isInteger(num))) throw new Error(`A plot's “${key}” is ${v}; ${what} must be ${whole ? 'whole numbers, ' : ''}zero or more.`);
+    return num;
+  });
