+// Projects kept in the viewer's claude.ai account, through the artifact's private per-person store
+// (`db` under data/users/<id>/, readable only by that person, not even by the page's owner) and the `user`
+// capability for the id. Outside claude.ai (a local build, a saved file) neither exists and the feature hides.
+//
+// Layout, one document each (every document must stay under the store's 256 KiB):
+//   data/users/<id>/terrax/projects/<projectId>                 name, savedAt, target, boundary, preferences, reportIds
+//   data/users/<id>/terrax/projects/<projectId>/reports/<rid>   one report, with as many of its figures as fit
+import type { Project } from './project';
+import { buildProject } from './project';
+import type { ReportRecord } from './types';
+
+/** The store's document limit is 256 KiB of serialised JSON; keep a margin for its own encoding. */
+export const DOC_LIMIT = 240 * 1024;
+
+export interface SavedProjectSummary {
+  id: string;
+  name: string;
+  savedAt: string;
+  reports: number;
+  droppedFigures: number;
+}
+
+const bytes = (v: unknown) => new TextEncoder().encode(JSON.stringify(v)).length;
+
+/** A report as one document: all figures if they fit, else the largest set of figures (in order) that does. */
+export function fitReport(r: ReportRecord, limit = DOC_LIMIT): { doc: ReportRecord; dropped: number } {
+  if (bytes(r) <= limit) return { doc: r, dropped: 0 };
+  const { figures = [], ...text } = r;
+  if (bytes(text) > limit) throw new Error(`The report “${r.title}” is too large to save in your account even without its figures. Export the project file instead.`);
+  const kept: NonNullable<ReportRecord['figures']> = [];
+  for (const f of figures) if (bytes({ ...text, figures: [...kept, f] }) <= limit) kept.push(f);
+  return { doc: kept.length ? { ...text, figures: kept } : text, dropped: figures.length - kept.length };
+}
+
+/** The project document without its reports (they are stored one per document). */
+export function projectHead(name: string, p: Project, limit = DOC_LIMIT) {
+  const head = { name, savedAt: new Date().toISOString(), target: p.target, boundary: p.boundary, preferences: p.preferences, reportIds: p.reports.map(r => r.id) };
+  if (bytes(head) > limit) throw new Error('The analysis boundary is too detailed to save in your account (over 240 KB). Simplify it, or export the project file instead.');
+  return head;
+}
+
+export function projectFromDocs(head: Record<string, unknown>, reports: ReportRecord[]): Project {
+  const order = new Map(((head.reportIds as string[]) ?? []).map((id, i) => [id, i]));
+  return buildProject({
+    target: (head.target as Project['target']) ?? null,
+    boundary: (head.boundary as Project['boundary']) ?? null,
+    preferences: (head.preferences as Record<string, unknown>) ?? {},
+    reports: [...reports].sort((a, b) => (order.get(a.id) ?? 0) - (order.get(b.id) ?? 0)),
+  });
+}
+
+// ── The capability calls (shapes per the artifact runtime's db and user contracts) ──
+
+interface DocSnap {
+  id: string;
+  exists: boolean;
+  data(): Record<string, unknown> | undefined;
+}
+interface DocRef {
+  id: string;
+  get(): Promise<DocSnap>;
+  set(data: Record<string, unknown>): Promise<void>;
+  delete(): Promise<void>;
+  collection(path: string): CollRef;
+}
+interface CollRef {
+  doc(id?: string): DocRef;
+  get(): Promise<{ docs: DocSnap[] }>;
+}
+interface Db {
+  doc(path: string): DocRef;
+}
+interface ClaudeRuntime {
+  use(name: 'db'): Promise<Db | null>;
+  use(name: 'user'): Promise<{ id(): Promise<string | null> } | null>;
+}
+
+export interface AccountStore {
+  list(): Promise<SavedProjectSummary[]>;
+  save(name: string, p: Project, replaceId?: string): Promise<SavedProjectSummary>;
+  open(id: string): Promise<Project>;
+  remove(id: string): Promise<void>;
+}
+
+/** The viewer's account store, or null when this view has no claude.ai account behind it. */
+export async function accountStore(): Promise<AccountStore | null> {
+  const rt = (globalThis as { claude?: ClaudeRuntime }).claude;
+  if (!rt || typeof rt.use !== 'function') return null;
+  const [db, user] = await Promise.all([rt.use('db'), rt.use('user')]);
+  const uid = user ? await user.id() : null;
+  if (!db || !uid) return null;
+  const projects = db.doc(`data/users/${uid}/terrax`).collection('projects');
+
+  const summary = (id: string, d: Record<string, unknown>): SavedProjectSummary => ({
+    id,
+    name: String(d.name ?? 'Untitled'),
+    savedAt: String(d.savedAt ?? ''),
+    reports: Array.isArray(d.reportIds) ? d.reportIds.length : 0,
+    droppedFigures: Number(d.droppedFigures ?? 0),
+  });
+  const clearReports = async (ref: DocRef) => {
+    for (const r of (await ref.collection('reports').get()).docs) await ref.collection('reports').doc(r.id).delete();
+  };
+
+  return {
+    async list() {
+      const snap = await projects.get();
+      return snap.docs.filter(d => d.exists).map(d => summary(d.id, d.data() ?? {})).sort((a, b) => b.savedAt.localeCompare(a.savedAt));
+    },
+    async save(name, p, replaceId) {
+      const fitted = p.reports.map(r => fitReport(r));
+      const head = { ...projectHead(name, p), droppedFigures: fitted.reduce((s, f) => s + f.dropped, 0) };
+      const ref = replaceId ? projects.doc(replaceId) : projects.doc();
+      if (replaceId) await clearReports(ref);
+      for (const f of fitted) await ref.collection('reports').doc(f.doc.id).set(f.doc as unknown as Record<string, unknown>); // one write at a time
+      await ref.set(head); // last, so a listed project always has its reports
+      return summary(ref.id, head);
+    },
+    async open(id) {
+      const ref = projects.doc(id);
+      const head = await ref.get();
+      if (!head.exists) throw new Error('This project is no longer in your account.');
+      const reports = (await ref.collection('reports').get()).docs.filter(d => d.exists).map(d => d.data() as unknown as ReportRecord);
+      return projectFromDocs(head.data() ?? {}, reports);
+    },
+    async remove(id) {
+      const ref = projects.doc(id);
+      await clearReports(ref); // nested documents survive a parent's delete, so delete them first
+      await ref.delete();
+    },
+  };
+}
+
+/** A store error as a sentence for the viewer (codes per the runtime's db contract). */
+export function accountError(err: unknown): string {
+  const code = (err as { code?: string })?.code;
+  if (code === 'invalid_argument') return 'Your access to this page does not let you save. Ask its owner for Contributor access, or export the project file instead.';
+  if (code === 'quota_exceeded') return 'Your saved projects are full. Delete some, or export project files instead.';
+  if (code === 'resource_exhausted') return 'Too many saves at once. Wait a moment and try again.';
+  if (code === 'unavailable' || code === 'revoked' || code === 'not_granted') return 'Saving to your account is unavailable right now. Export the project file instead.';
+  return err instanceof Error ? err.message : 'That did not work.';
+}
