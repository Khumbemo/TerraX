+export const CARBON_FRACTION = 0.47;
+export const CO2_PER_C = 44 / 12;
+
+type PlotFeature = Feature<Polygon | MultiPolygon>;
+
+export interface FieldPlots {
+  name: string;
+  feats: PlotFeature[];
+  countKey: string | null;
+  agbKey: string | null;
+}
+
+/** The plots (polygons) of a parsed file and the properties holding each plot's tree count and biomass (Mg/ha). */
+export function readPlots(name: string, fc: FeatureCollection, countField?: string, agbField?: string): FieldPlots {
+  const feats = fc.features.filter((f): f is PlotFeature => f.geometry?.type === 'Polygon' || f.geometry?.type === 'MultiPolygon');
+  if (!feats.length) throw new Error(`${name} has no polygons. Field plots are polygons, each with the trees counted or the biomass measured in it.`);
+  const keys = new Map<string, string>();
+  for (const f of feats) for (const k of Object.keys(f.properties ?? {})) keys.set(k.toLowerCase(), k);
+  const pick = (wanted: string | undefined, names: string[]) => {
+    const w = (wanted ?? '').trim();
+    if (w) {
+      if (!keys.has(w.toLowerCase())) throw new Error(`${name} has no property “${w}”.`);
+      return keys.get(w.toLowerCase())!;
+    }
+    const hit = names.find(n => keys.has(n));
+    return hit ? keys.get(hit)! : null;
+  };
+  const countKey = pick(countField, COUNT_FIELDS), agbKey = pick(agbField, AGB_FIELDS);
+  if (!countKey && !agbKey) throw new Error(`Name the property with each plot's tree count or biomass (Mg/ha); TerraX looks for ${COUNT_FIELDS.join(', ')} or ${AGB_FIELDS.join(', ')}.`);
