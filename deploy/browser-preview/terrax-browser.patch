+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { openGeoTiff, type GeoMeta } from '../src/lib/rasterio';
+import { radarOnGrid } from '../src/lib/tools/landcover';
+
+test('radar reprojected onto an optical grid in another CRS agrees with rasterio’s bilinear warp (linear power)', async () => {
+  const f = JSON.parse(readFileSync(new URL('./fixtures/radar_reproject.json', import.meta.url), 'utf8'));
+  const buf = Buffer.from(f.tiffBase64, 'base64'); // a 36 × 36 two-band WGS84 GeoTIFF written by rasterio
+  const radar = await openGeoTiff(new File([buf], 'radar_wgs84.tif'));
+  const optical = { filename: 'optical.tif', width: f.w, height: f.h, bands: 4, bbox: f.bbox, epsg: f.epsg, geographic: false, noData: null, latLngBounds: null, pixelSize: [10, 10], warnings: [], sizeBytes: 0 } as GeoMeta;
+  const r = await radarOnGrid(optical, f.w, f.h, { raster: radar, vv: 0, vh: 1 });
+  assert.equal(r.aligned, true);
+  assert.equal(r.scale, 'linear');
+  let compared = 0, worst = 0, onlyOne = 0;
+  for (const [mine, want] of [[r.vv, f.vv], [r.vh, f.vh]] as [Float64Array, (number | null)[]][]) {
+    want.forEach((v, k) => {
+      if (v === null || !Number.isFinite(mine[k])) {
+        if ((v === null) !== !Number.isFinite(mine[k])) onlyOne++;
+        return;
+      }
+      compared++;
+      worst = Math.max(worst, Math.abs(mine[k] - v) / v);
+    });
+  }
+  assert.ok(compared > 4000, `compared ${compared}`);
+  // GDAL warps through an approximate transformer (error ≤ 0.125 px); values agree to 2e-5 of the backscatter here, and
+  // only a handful of cells next to the no-data pixels are filled by one warp and not the other.
+  assert.ok(worst < 1e-3, `largest relative difference ${worst}`);
+  assert.ok(onlyOne <= 10, `cells covered by only one of the two: ${onlyOne}`);
+});
