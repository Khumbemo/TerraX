+test('map streams keep whole highest orders within the vertex budget', async () => {
+  const { mapStreams, MAP_STREAM_POINTS } = await import('../src/lib/tools/hydrology');
+  const line = (strahler: number, n: number) => ({ type: 'Feature' as const, properties: { strahler }, geometry: { type: 'LineString' as const, coordinates: Array.from({ length: n }, () => [0, 0]) } });
+  const fc = (...f: ReturnType<typeof line>[]) => ({ type: 'FeatureCollection' as const, features: f });
+  const small = fc(line(1, 10), line(2, 5));
+  assert.equal(mapStreams(small).fc, small);
+  assert.equal(mapStreams(small).note, null);
+  const big = mapStreams(fc(line(1, MAP_STREAM_POINTS), line(2, 40), line(3, 5)));
+  assert.deepEqual(big.fc.features.map(f => f.properties.strahler), [2, 3]);
+  assert.match(big.note ?? '', /order 2 and above \(2 of 3 lines\)/);
+  const none = mapStreams(fc(line(4, MAP_STREAM_POINTS + 1)));
+  assert.equal(none.fc.features.length, 0);
+  assert.match(none.note ?? '', /\(1 line\) is too large to draw/);
+});
+
+test('D∞ specific catchment area on a cone (a = r/2) and planes (a = upslope length), with mass balance', async () => {
+  const { dinfFlow, fillDepressions, flowRouting } = await import('../src/lib/tools/hydrology');
+  const n = 201, c0 = 100;
+  const geo = { spacing: () => ({ dx: 1, dy: 1 }), cellArea: () => 1 };
+  const cone = new Float32Array(n * n);
+  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) cone[r * n + c] = 1000 - Math.hypot(r - c0, c - c0);
+  const d = dinfFlow(fillDepressions(cone, n, n).filled, n, n, geo);
+  const d8 = flowRouting({ width: n, height: n, data: cone, resampleFactor: 1 }, geo, 1e12);
+  const errs: number[] = [], errs8: number[] = [];
+  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) {
+    const rad = Math.hypot(r - c0, c - c0);
+    if (rad <= 10 || rad >= 80) continue;
+    errs.push(Math.abs(d.sca[r * n + c] / (rad / 2) - 1));
+    errs8.push(Math.abs(d8.acc[r * n + c] / (rad / 2) - 1));
+  }
+  const median = (a: number[]) => [...a].sort((x, y) => x - y)[a.length >> 1];
+  assert.ok(median(errs) < 0.1, `D∞ median error ${median(errs)}`);
+  assert.ok(median(errs) < median(errs8) / 4, `D8 median error ${median(errs8)}`);
+  for (const deg of [0, 30, 45, 60]) {
+    const t = (deg * Math.PI) / 180;
+    const z = new Float32Array(n * n);
+    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) z[r * n + c] = -(c * Math.cos(t) + -r * Math.sin(t));
+    const p = dinfFlow(fillDepressions(z, n, n).filled, n, n, geo);
+    const e: number[] = [];
+    let out = 0;
+    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) {
+      if (p.tanb[r * n + c] === 0) out += p.acc[r * n + c];
+      if (r <= 20 || r >= n - 20 || c <= 20 || c >= n - 20) continue;
+      let len = Infinity;
+      if (Math.cos(t) > 1e-9) len = Math.min(len, (c + 0.5) / Math.cos(t));
+      if (Math.sin(t) > 1e-9) len = Math.min(len, (n - 0.5 - r) / Math.sin(t));
+      e.push(Math.abs(p.sca[r * n + c] / len - 1));
+    }
+    assert.ok(median(e) < 0.02, `plane ${deg}°: ${median(e)}`);
+    assert.ok(Math.abs(out - n * n) < 1e-6 * n * n, `mass balance at ${deg}°: ${out}`);
+  }
+});
+
+test('contours: rings on a cone, Douglas–Peucker within tolerance, gaps split lines, saddles never cross', () => {
+  const n = 61;
+  const r = grid(n, n, (x, y) => -Math.hypot(x + 0.5 - n / 2, y + 0.5 - n / 2)).data;
+  for (const { level, lines } of contourGrid(r, n, n, [-5, -20])) {
+    assert.equal(lines.length, 1);
+    assert.deepEqual(lines[0][0], lines[0][lines[0].length - 1], 'closed ring');
+    assert.ok(lines[0].every(([x, y]) => Math.abs(Math.hypot(x - n / 2, y - n / 2) + level) < 0.15));
+  }
+  const full = contourGrid(r, n, n, [-20])[0].lines[0];
+  const simple = contourGrid(r, n, n, [-20], 0.25)[0].lines[0];
+  assert.ok(simple.length > 8 && simple.length < full.length);
+  const dist = (p: [number, number], a: [number, number], b: [number, number]) => Math.abs((b[0] - a[0]) * (a[1] - p[1]) - (a[0] - p[0]) * (b[1] - a[1])) / Math.hypot(b[0] - a[0], b[1] - a[1]);
+  assert.ok(full.every(p => Math.min(...simple.slice(1).map((q, i) => dist(p, simple[i], q))) <= 0.25 + 1e-9));
+  const gap = grid(8, 6, x => x).data;
+  for (let x = 0; x < 8; x++) gap[2 * 8 + x] = NaN;
+  assert.equal(contourGrid(gap, 8, 6, [5.5])[0].lines.length, 2);
+  assert.equal(contourGrid(Float32Array.from([1, 0, 0, 1]), 2, 2, [0.5])[0].lines.length, 2);
+});
+
+test('D∞ upslope dependence: Σ area × share equals the outlet’s D∞ area, and matches flow pushed by brute force', async () => {
+  const { dinfDependence, dinfFlow, fillDepressions } = await import('../src/lib/tools/hydrology');
+  const n = 30;
+  let seed = 5;
+  const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
+  const z = grid(n, n, (x, y) => 0.3 * x + 0.2 * y + 2 * Math.sin(x / 5) * Math.cos(y / 7) + (rand() - 0.5) * 0.6).data;
+  const geo = { spacing: () => ({ dx: 1, dy: 1 }), cellArea: () => 1 };
+  const filled = fillDepressions(z, n, n).filled;
+  const d = dinfFlow(filled, n, n, geo);
+  const F_R1 = [0, -1, -1, 0, 0, 1, 1, 0], F_C1 = [1, 0, 0, -1, -1, 0, 0, 1], F_R2 = [-1, -1, -1, -1, 1, 1, 1, 1], F_C2 = [1, 1, -1, -1, -1, -1, 1, 1];
+  const order = Array.from({ length: n * n }, (_, i) => i).sort((a, b) => filled[b] - filled[a] || a - b);
+  for (const outlet of [15 * n + 15, 3 * n + 3]) {
+    const dep = dinfDependence(d.facet, d.share, n, n, outlet);
+    assert.equal(dep[outlet], 1);
+    assert.ok(Math.abs(dep.reduce((s, v) => s + v, 0) - d.acc[outlet]) < 1e-3 * d.acc[outlet]);
+    for (let start = 0; start < n * n; start += 37) {
+      const mass = new Float64Array(n * n);
+      mass[start] = 1;
+      let reached = 0;
+      for (const k of order) {
+        const m = mass[k];
+        if (!m) continue;
+        if (k === outlet) {
+          reached += m;
+          continue;
+        }
+        const f = d.facet[k];
+        if (f < 0) continue;
+        const r = Math.floor(k / n), c = k % n, p2 = d.share[k];
+        mass[(r + F_R1[f]) * n + c + F_C1[f]] += m * (1 - p2);
+        mass[(r + F_R2[f]) * n + c + F_C2[f]] += m * p2;
+      }
+      assert.ok(Math.abs(dep[start] - reached) < 1e-5, `cell ${start}: ${dep[start]} vs ${reached}`);
+    }
+  }
+});
