+    let s = 0;
+    for (let i = -r; i <= r; i++) s += kern[i + r] * z[y * w + refl(x + i, w)];
+    tmp[y * w + x] = s;
+  }
+  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
+    let s = 0;
+    for (let i = -r; i <= r; i++) s += kern[i + r] * tmp[refl(y + i, h) * w + x];
