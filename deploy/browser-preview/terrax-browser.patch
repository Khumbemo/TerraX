index 0000000..b15d2b6
--- /dev/null
+++ b/src/components/tools/MapValidation.tsx
@@ -0,0 +1,230 @@
+import { useState } from 'react';
+import Papa from 'papaparse';
+import type { FeatureCollection } from 'geojson';
+import { downloadText, safeFilename } from '../../lib/download';
+import { unprojector } from '../../lib/patches';
+import type { GeoMeta } from '../../lib/rasterio';
+import { fmt } from '../../lib/stats';
+import { useToast } from '../../lib/toast';
+import { accuracyMarkdown, allocate, assess, stratifiedSample, type Accuracy } from '../../lib/tools/accuracy';
+import FileDrop from '../FileDrop';
+
+interface Sample {
+  points: { id: string; cell: number; cls: number }[];
+  labels: string[];
+  areas: number[];
+  unit: 'ha' | 'px';
+  allocation: { label: string; mapped: number; share: number; n: number }[];
+}
+
+export type MapAccuracy = Accuracy & { unit: string; missing: number };
+
+const pct = (v: number | null, ci: number | null) => (v === null ? '—' : `${(v * 100).toFixed(1)} %${ci === null ? '' : ` ± ${(ci * 100).toFixed(1)}`}`);
+
+/** {sample id: reference label} from the returned CSV or GeoJSON. */
+async function readLabels(file: File): Promise<Map<string, string>> {
+  const text = await file.text();
+  const out = new Map<string, string>();
+  if (/\.(geo)?json$/i.test(file.name)) {
+    const fc = JSON.parse(text) as FeatureCollection;
+    for (const f of fc.features ?? []) {
+      const p = Object.fromEntries(Object.entries(f.properties ?? {}).map(([k, v]) => [k.toLowerCase(), v]));
+      if (p.id !== undefined && p.id !== '') out.set(String(p.id).trim(), p.reference == null ? '' : String(p.reference).trim());
+    }
+    return out;
+  }
+  const rows = Papa.parse<Record<string, string>>(text.replace(/^﻿/, ''), { header: true, skipEmptyLines: true, transformHeader: h => h.trim().toLowerCase() }).data;
+  for (const r of rows) if (r.id) out.set(r.id.trim(), (r.reference ?? '').trim());
+  return out;
+}
+
+/** Mapped area of classes 1..k: hectares when the grid has ground units, else pixels. */
+export function mappedAreas(classes: Uint8Array, width: number, k: number, cellArea: ((row: number) => number) | null): { areas: number[]; unit: 'ha' | 'px' } {
+  const areas = new Array<number>(k).fill(0);
+  for (let p = 0; p < classes.length; p++) {
+    const c = classes[p];
+    if (c >= 1 && c <= k) areas[c - 1] += cellArea ? cellArea(Math.floor(p / width)) / 1e4 : 1;
+  }
+  return { areas, unit: cellArea ? 'ha' : 'px' };
+}
+
+interface Props {
+  /** Prefix of the element ids (landcover-sample, forest-sample, …). */
+  idPrefix: string;
+  intro: string;
+  /** Class map: 0 = no data, 1..k = labels[0..k−1]. */
+  classes: Uint8Array;
+  width: number;
+  height: number;
+  labels: string[];
+  areas: number[];
+  unit: 'ha' | 'px';
+  meta: GeoMeta;
+  filename: string;
+  busy?: boolean;
+  onAccuracy: (a: MapAccuracy | null) => void;
+}
+
+/**
+ * Accuracy and area of a class map from a stratified random sample (Olofsson et al. 2014): draw the sample, label it
+ * outside TerraX, load it back. Shared by land cover and forest change / burn severity, as on the server.
+ */
+export default function MapValidation({ idPrefix, intro, classes, width, height, labels, areas, unit, meta, filename, busy, onAccuracy }: Props) {
+  const notify = useToast();
+  const k = labels.length;
+  const [sampleTotal, setSampleTotal] = useState('');
+  const [minPerClass, setMinPerClass] = useState('50');
+  const [sample, setSample] = useState<Sample | null>(null);
+  const [accuracy, setAccuracyState] = useState<MapAccuracy | null>(null);
+  const setAccuracy = (a: MapAccuracy | null) => {
+    setAccuracyState(a);
+    onAccuracy(a);
+  };
+  const present = areas.filter(a => a > 0).length;
+
+  const makeSample = () => {
+    const min = Number(minPerClass);
+    const total = sampleTotal.trim() ? Number(sampleTotal) : Math.max(100 * present, min * present);
+    if (!Number.isInteger(total) || total < 2 || !Number.isInteger(min) || min < 1) return notify('Set the sample size and minimum per class as whole numbers.', 'error');
+    const sizes = allocate(areas, total, min);
+    const pts = stratifiedSample(classes, labels.map((_, i) => i + 1), sizes, 11)
+      .sort((a, b) => a.cls - b.cls || a.cell - b.cell)
+      .map((p, i) => ({ ...p, id: `S${String(i + 1).padStart(4, '0')}` }));
+    const un = unprojector(meta), bb = meta.bbox;
+    const ll = (cell: number): [number, number] | null => {
+      if (!un || !bb) return null;
+      const col = cell % width, row = Math.floor(cell / width);
+      const [lon, lat] = un(bb[0] + ((col + 0.5) / width) * (bb[2] - bb[0]), bb[3] - ((row + 0.5) / height) * (bb[3] - bb[1]));
+      return [Math.round(lon * 1e7) / 1e7, Math.round(lat * 1e7) / 1e7];
+    };
+    const base = safeFilename(filename);
+    const csv = ['id,lon,lat,row,col,map_class,reference', ...pts.map(p => {
+      const c = ll(p.cell);
+      return `${p.id},${c ? c[0] : ''},${c ? c[1] : ''},${Math.floor(p.cell / width)},${p.cell % width},"${(labels[p.cls - 1] ?? '').replace(/"/g, '""')}",`;
+    })].join('\n');
+    downloadText(csv, `${base}_validation_sample.csv`, 'text/csv');
+    if (un) {
+      const fc = { type: 'FeatureCollection', features: pts.map(p => ({ type: 'Feature', properties: { id: p.id, map_class: labels[p.cls - 1], reference: '' }, geometry: { type: 'Point', coordinates: ll(p.cell) } })) };
+      downloadText(JSON.stringify(fc), `${base}_validation_sample.geojson`, 'application/geo+json');
+    }
+    const sum = areas.reduce((a, b) => a + b, 0) || 1;
+    setSample({ points: pts, labels: [...labels], areas: [...areas], unit, allocation: areas.map((a, i) => ({ label: labels[i], mapped: a, share: a / sum, n: sizes[i] })).filter(a => a.mapped > 0) });
+    setAccuracy(null);
+  };
+
+  const assessFile = async (file: File) => {
+    if (!sample) return;
+    try {
+      const refs = await readLabels(file);
+      const byName = new Map(sample.labels.map((l, i) => [l.trim().toLowerCase(), i]));
+      const counts = Array.from({ length: k }, () => new Array(k).fill(0));
+      const unknown = new Set<string>();
+      let missing = 0;
+      for (const p of sample.points) {
+        const ref = refs.get(p.id) ?? '';
+        if (!ref) {
+          missing++;
+          continue;
+        }
+        let j = byName.get(ref.toLowerCase());
+        if (j === undefined && /^\d+$/.test(ref) && +ref >= 1 && +ref <= k) j = +ref - 1;
+        if (j === undefined) unknown.add(ref);
+        else counts[p.cls - 1][j]++;
+      }
+      if (unknown.size) throw new Error(`Reference labels must be one of the map’s classes (${sample.labels.join(', ')}) or their numbers; found ${[...unknown].sort().join(', ')}.`);
+      if (!counts.flat().some(Boolean)) throw new Error('No sample point has a reference label yet. Fill in the “reference” column and load the file again.');
+      setAccuracy({ ...assess(counts, sample.areas, sample.labels), unit: sample.unit, missing });
+    } catch (err) {
+      notify(err instanceof Error ? err.message : 'The labelled sample could not be read.', 'error');
+    }
+  };
+
+  return (
+    <section className="sub-panel" aria-label="Accuracy assessment">
+      <div className="eyebrow">Accuracy and area</div>
+      <p className="field-hint">{intro}</p>
+      <div className="param-row">
+        <label className="param">
+          <span>Sample points</span>
+          <input id={`${idPrefix}-sample-total`} type="number" min="2" step="1" placeholder={String(100 * present)} value={sampleTotal} onChange={e => setSampleTotal(e.target.value)} />
+        </label>
+        <label className="param">
+          <span>Minimum per class</span>
+          <input id={`${idPrefix}-sample-min`} type="number" min="1" step="1" value={minPerClass} onChange={e => setMinPerClass(e.target.value)} />
+        </label>
+        <button type="button" id={`${idPrefix}-sample`} className="btn" disabled={busy} onClick={makeSample}>
+          {sample ? 'Draw a new sample' : 'Create validation sample'}
+        </button>
+      </div>
+      {sample && (
+        <>
+          <div className="tabular-view">
+            <table>
+              <thead>
+                <tr>
+                  <th>Class</th>
+                  <th>Mapped</th>
+                  <th>Share</th>
+                  <th>Points</th>
+                </tr>
+              </thead>
+              <tbody>
+                {sample.allocation.map(a => (
+                  <tr key={a.label}>
+                    <td>{a.label}</td>
+                    <td className="num">{sample.unit === 'ha' ? `${fmt(a.mapped, 4)} ha` : `${a.mapped.toLocaleString()} px`}</td>
+                    <td className="num">{(a.share * 100).toFixed(1)} %</td>
+                    <td className="num">{a.n}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          <p className="field-hint">The sample was downloaded as CSV{unprojector(meta) ? ' and GeoJSON' : ''}. Fill in each point’s “reference” column, then load the file here.</p>
+          <FileDrop id={`${idPrefix}-reference`} label="Labelled sample" accept=".csv,.geojson,.json" hint="The sample file with its “reference” column filled in" onFile={assessFile} />
+        </>
+      )}
+      {accuracy && (
+        <>
+          <div className="stat-grid">
+            <div className="stat">
+              <div className="stat-label">Overall accuracy</div>
+              <div className="stat-value">{pct(accuracy.overallAccuracy, accuracy.overallCi)}</div>
+            </div>
+            <div className="stat">
+              <div className="stat-label">Reference points</div>
+              <div className="stat-value">{`${accuracy.samples}${accuracy.missing ? ` (${accuracy.missing} unlabelled)` : ''}`}</div>
+            </div>
+          </div>
+          <div className="tabular-view">
+            <table id={`${idPrefix}-accuracy`}>
+              <thead>
+                <tr>
+                  <th>Class</th>
+                  <th>Mapped</th>
+                  <th>Estimated area (95 % CI)</th>
+                  <th>User’s</th>
+                  <th>Producer’s</th>
+                </tr>
+              </thead>
+              <tbody>
+                {accuracy.classes.map(c => (
+                  <tr key={c.label}>
+                    <td>{c.label}</td>
+                    <td className="num">{fmt(c.mappedArea, 4)} {accuracy.unit}</td>
+                    <td className="num">
+                      {fmt(c.area, 4)} {accuracy.unit}
+                      {c.areaCi === null ? '' : ` ± ${fmt(c.areaCi, 3)}`}
+                    </td>
+                    <td className="num">{pct(c.userAccuracy, c.userCi)}</td>
+                    <td className="num">{pct(c.producerAccuracy, c.producerCi)}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        </>
+      )}
+    </section>
+  );
+}
