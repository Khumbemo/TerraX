+
+/** A grid in a projected (or geographic) CRS: west, south, east, north of its extent in CRS units. */
+export interface PlotGrid {
+  width: number;
+  height: number;
+  bbox: [number, number, number, number];
+  /** WGS84 lon/lat → CRS. */
+  project: (lon: number, lat: number) => [number, number];
+}
+
+function projectRings(g: Polygon | MultiPolygon, grid: PlotGrid): [number, number][][][] {
+  const polys = g.type === 'Polygon' ? [g.coordinates] : g.coordinates;
+  return polys.map(rings => rings.map(r => r.map((p: Position) => grid.project(p[0], p[1]))));
+}
+
+/** Whether a plot lies wholly on the grid's extent. A plot drawn along the grid's edge comes back from WGS84 a fraction
+ * of a millimetre off it, so the edge is widened by 1 % of a cell. */
+export function onGrid(g: Polygon | MultiPolygon, grid: PlotGrid): boolean {
+  const [x0, y0, x1, y1] = grid.bbox;
+  const ex = (0.01 * (x1 - x0)) / grid.width, ey = (0.01 * (y1 - y0)) / grid.height;
+  return projectRings(g, grid).every(poly => poly[0].every(([x, y]) => x >= x0 - ex && x <= x1 + ex && y >= y0 - ey && y <= y1 + ey));
