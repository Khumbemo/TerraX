+export interface CanopyResult {
+  areaHa: number;
+  threshold: number;
+  cover: number;
+  coverFao: number;
+  height: { median: number | null; q1: number | null; q3: number | null; p95: number | null; max: number | null; mean: number | null };
+  classes: { label: string; ha: number }[];
+  trees: { cells: number[]; heights: number[]; count: number; perHa: number | null; minHeight: number; meanHeight: number | null };
+}
+
+export function analyzeCanopy(chm: Float32Array, w: number, h: number, cellArea: (row: number) => number, cellM: number, threshold = 2, minTree = 5): CanopyResult {
+  let area = 0, canopy = 0, fao = 0;
+  const heights: number[] = [];
+  const cls = HEIGHT_CLASSES.map(() => 0);
+  for (let k = 0; k < chm.length; k++) {
+    const v = chm[k];
+    if (Number.isNaN(v)) continue;
+    const a = cellArea(Math.floor(k / w));
+    area += a;
+    if (v >= threshold) (canopy += a), heights.push(v);
+    if (v >= 5) fao += a;
+    const i = HEIGHT_CLASSES.findIndex(([lo, hi]) => v >= lo && v < hi);
+    if (i >= 0) cls[i] += a;
+  }
+  if (!area) throw new Error('The canopy height model has no valid cells.');
+  heights.sort((a, b) => a - b);
+  const q = (p: number) => {
+    if (!heights.length) return null;
+    const hh = (heights.length - 1) * p, lo = Math.floor(hh), hi = Math.ceil(hh);
+    return heights[lo] + (hh - lo) * (heights[hi] - heights[lo]);
+  };
