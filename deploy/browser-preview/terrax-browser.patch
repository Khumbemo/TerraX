+test('D∞ specific catchment area on a cone (a = r/2) and planes (a = upslope length), with mass balance', async () => {
+  const { dinfFlow, fillDepressions, flowRouting } = await import('../src/lib/tools/hydrology');
+  const n = 201, c0 = 100;
+  const geo = { spacing: () => ({ dx: 1, dy: 1 }), cellArea: () => 1 };
+  const cone = new Float32Array(n * n);
+  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) cone[r * n + c] = 1000 - Math.hypot(r - c0, c - c0);
+  const d = dinfFlow(fillDepressions(cone, n, n).filled, n, n, geo);
+  const d8 = flowRouting({ width: n, height: n, data: cone, resampleFactor: 1 }, geo, 1e12);
+  const errs: number[] = [], errs8: number[] = [];
+  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) {
+    const rad = Math.hypot(r - c0, c - c0);
+    if (rad <= 10 || rad >= 80) continue;
+    errs.push(Math.abs(d.sca[r * n + c] / (rad / 2) - 1));
+    errs8.push(Math.abs(d8.acc[r * n + c] / (rad / 2) - 1));
+  }
+  const median = (a: number[]) => [...a].sort((x, y) => x - y)[a.length >> 1];
+  assert.ok(median(errs) < 0.1, `D∞ median error ${median(errs)}`);
+  assert.ok(median(errs) < median(errs8) / 4, `D8 median error ${median(errs8)}`);
+  for (const deg of [0, 30, 45, 60]) {
+    const t = (deg * Math.PI) / 180;
+    const z = new Float32Array(n * n);
+    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) z[r * n + c] = -(c * Math.cos(t) + -r * Math.sin(t));
+    const p = dinfFlow(fillDepressions(z, n, n).filled, n, n, geo);
+    const e: number[] = [];
+    let out = 0;
+    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) {
+      if (p.tanb[r * n + c] === 0) out += p.acc[r * n + c];
+      if (r <= 20 || r >= n - 20 || c <= 20 || c >= n - 20) continue;
+      let len = Infinity;
+      if (Math.cos(t) > 1e-9) len = Math.min(len, (c + 0.5) / Math.cos(t));
+      if (Math.sin(t) > 1e-9) len = Math.min(len, (n - 0.5 - r) / Math.sin(t));
+      e.push(Math.abs(p.sca[r * n + c] / len - 1));
+    }
+    assert.ok(median(e) < 0.02, `plane ${deg}°: ${median(e)}`);
+    assert.ok(Math.abs(out - n * n) < 1e-6 * n * n, `mass balance at ${deg}°: ${out}`);
+  }
+});
