+++ b/tests/crs.test.ts
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { writeArrayBuffer } from 'geotiff';
+import { groundGeometry, openGeoTiff } from '../src/lib/rasterio';
+import { projector } from '../src/lib/zonal';
+import { unprojector } from '../src/lib/patches';
+
+async function grid(epsg: number, x0: number, y1: number, cell: number, n = 50) {
+  const buf = await writeArrayBuffer(new Float32Array(n * n).fill(1), { width: n, height: n, ModelPixelScale: [cell, cell, 0], ModelTiepoint: [0, 0, 0, x0, y1, 0], GTModelTypeGeoKey: 1, GTRasterTypeGeoKey: 1, ProjectedCSTypeGeoKey: epsg });
+  return openGeoTiff(new File([buf], `epsg${epsg}.tif`));
+}
+
+// Expected values from the Python server (pyproj Geod on the same grids, terrax.processing.rio._geodesic_ground).
+for (const [epsg, x0, y1, cell, dx, area0, areaLast] of [
+  [2263, 980_000, 220_000, 100, 30.48018713551553, 929.0418047885818, 929.0411503740414], // NY Long Island, US survey feet
+  [7755, 7_000_000, 3_000_000, 30, 29.965786580983814, 897.9480327900723, 897.8665745869852], // WGS 84 / India NSF LCC, metres
+] as const) {
+  test(`EPSG:${epsg}: ground units match the server's geodesic measurement`, async () => {
+    const r = await grid(epsg, x0, y1, cell);
+    assert.ok(r.meta.crs, 'custom CRS read from the geokeys');
+    assert.ok(r.meta.latLngBounds, 'footprint on the map');
+    const g = groundGeometry(r.meta, { width: 50, height: 50 })!;
+    assert.ok(Math.abs(g.spacing(0).dx / dx - 1) < 1e-6, `dx ${g.spacing(0).dx}`);
+    assert.ok(Math.abs(g.cellArea(0) / area0 - 1) < 1e-6 && Math.abs(g.cellArea(49) / areaLast - 1) < 1e-6, `area ${g.cellArea(0)}`);
+    // Projection round trip.
+    const [lon, lat] = unprojector(r.meta)!(x0 + 5 * cell, y1 - 7 * cell);
+    const [x, y] = projector(r.meta)!(lon, lat);
+    assert.ok(Math.abs(x - (x0 + 5 * cell)) < 1e-4 && Math.abs(y - (y1 - 7 * cell)) < 1e-4);
+  });
+}
