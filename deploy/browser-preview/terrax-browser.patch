+const tileOf = (lon: number, lat: number, z: number) => {
+  const n = 2 ** z;
+  return [Math.floor(((lon + 180) / 360) * n), Math.floor(((1 - Math.asinh(Math.tan((lat * Math.PI) / 180)) / Math.PI) / 2) * n)];
+};
