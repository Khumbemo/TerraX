--- /dev/null
+++ b/src/lib/tools/radar.ts
@@ -0,0 +1,197 @@
+// Sentinel-1 (C-band SAR) backscatter: speckle filtering, polarisation indices and change between two dates.
+//  • Inputs: VV and VH backscatter (σ⁰ or γ⁰), in dB (Earth Engine COPERNICUS/S1_GRD) or linear power (ASF RTC),
+//    detected from the values. Speckle is multiplicative, so averages are taken in linear power.
+//  • Lee (1980) filter: x̂ = x̄ + b (z − x̄), b = var(x)/var(z), var(x) = (var(z) − x̄² C_v²)/(1 + C_v²), C_v² = 1/ENL
+//    (ENL ≈ 4.4 for IW GRDH, ESA Sentinel-1 Product Definition).
+//  • Dual-pol RVI = 4 σ⁰VH / (σ⁰VV + σ⁰VH).
+//  • Change: VH log ratio 10·log₁₀(after/before) (Rignot & van Zyl 1993); ≤ −t dB decrease, ≥ +t dB increase.
+import type { Grid } from '../rasterio';
+import { fmt } from '../stats';
+
+export const ENL_IW_GRD = 4.4;
+export const CHANGE_CLASSES = [
+  { id: 1, label: 'Backscatter decrease', color: [239, 68, 68] as [number, number, number] },
+  { id: 2, label: 'No significant change', color: [148, 163, 184] as [number, number, number] },
+  { id: 3, label: 'Backscatter increase', color: [59, 130, 246] as [number, number, number] },
+];
+
+export interface Quartiles {
+  n: number;
+  mean: number;
+  median: number;
+  q1: number;
+  q3: number;
+  min: number;
+  max: number;
+}
+
+/** "db" when the band looks logarithmic (land backscatter in dB is mostly negative), else "linear". */
+export function detectScale(g: Grid): 'db' | 'linear' {
+  const step = Math.max(1, Math.floor(g.data.length / 65536));
+  const v: number[] = [];
+  for (let k = 0; k < g.data.length; k += step) if (Number.isFinite(g.data[k])) v.push(g.data[k]);
+  v.sort((a, b) => a - b);
+  return v.length && v[v.length >> 1] < 0 ? 'db' : 'linear';
+}
+
+export function toLinear(g: Grid, scale: 'db' | 'linear'): Float64Array {
+  const out = new Float64Array(g.data.length);
+  for (let k = 0; k < out.length; k++) {
+    const v = g.data[k];
+    out[k] = !Number.isFinite(v) ? NaN : scale === 'db' ? 10 ** (v / 10) : v > 0 ? v : NaN;
+  }
+  return out;
+}
+
+/** Lee (1980) speckle filter on linear power, size × size window (odd), NaN cells left out of the local statistics. */
+export function leeFilter(z: Float64Array, w: number, h: number, size = 5, enl = ENL_IW_GRD): Float64Array {
+  if (size <= 1) return z.slice();
+  const r = size >> 1, W = w + 1;
+  // Summed-area tables of count, value and value² (O(n) for any window).
+  const sn = new Float64Array(W * (h + 1)), s1 = new Float64Array(W * (h + 1)), s2 = new Float64Array(W * (h + 1));
+  for (let y = 0; y < h; y++) {
+    let rn = 0, r1 = 0, r2 = 0;
+    for (let x = 0; x < w; x++) {
+      const v = z[y * w + x];
+      if (Number.isFinite(v)) (rn += 1), (r1 += v), (r2 += v * v);
+      const k = (y + 1) * W + x + 1;
+      sn[k] = sn[k - W] + rn;
+      s1[k] = s1[k - W] + r1;
+      s2[k] = s2[k - W] + r2;
+    }
+  }
+  const box = (t: Float64Array, x0: number, y0: number, x1: number, y1: number) => t[y1 * W + x1] - t[y0 * W + x1] - t[y1 * W + x0] + t[y0 * W + x0];
+  const cv2 = 1 / enl, out = new Float64Array(z.length);
+  for (let y = 0; y < h; y++) {
+    // At the grid edge the window is truncated to the cells inside it (the server version reflects the grid there, so
+    // the two differ only within size/2 cells of the edge).
+    const y0 = Math.max(0, y - r), y1 = Math.min(h, y + r + 1);
+    for (let x = 0; x < w; x++) {
+      const k = y * w + x, v = z[k];
+      if (!Number.isFinite(v)) {
+        out[k] = NaN;
+        continue;
+      }
+      const x0 = Math.max(0, x - r), x1 = Math.min(w, x + r + 1);
+      const n = box(sn, x0, y0, x1, y1), mean = box(s1, x0, y0, x1, y1) / n;
+      const varZ = Math.max(box(s2, x0, y0, x1, y1) / n - mean * mean, 0);
+      const varX = Math.max((varZ - mean * mean * cv2) / (1 + cv2), 0);
+      const b = varZ > 0 ? varX / varZ : 0;
+      out[k] = mean + b * (v - mean);
+    }
+  }
+  return out;
+}
+
+export function quartiles(values: Float64Array | number[]): Quartiles | null {
+  const v = Float64Array.from(values).sort();
+  if (!v.length) return null;
+  const q = (p: number) => {
+    const hh = (v.length - 1) * p, lo = Math.floor(hh), hi = Math.ceil(hh);
+    return v[lo] + (hh - lo) * (v[hi] - v[lo]);
+  };
+  let s = 0;
+  for (const x of v) s += x;
+  return { n: v.length, mean: s / v.length, median: q(0.5), q1: q(0.25), q3: q(0.75), min: v[0], max: v[v.length - 1] };
+}
+
+const db = (x: number) => 10 * Math.log10(x);
+
+export interface RadarDate {
+  name: string;
+  scale: 'db' | 'linear';
+  vv: Quartiles | null;
+  vh: Quartiles | null;
+  ratio: Quartiles | null;
+  rvi: Quartiles | null;
+}
+
+export interface RadarResult {
+  width: number;
+  height: number;
+  dates: RadarDate[];
+  /** Filtered VV and VH (dB) of the last image, for display. */
+  vvDb: Float32Array;
+  vhDb: Float32Array;
+  change: { classes: Uint8Array; counts: [number, number, number]; logRatio: Quartiles | null } | null;
+  size: number;
+  enl: number;
+  thresholdDb: number;
+}
+
+/** Per-date statistics and, for two images, the VH log-ratio change classes (1 decrease, 2 stable, 3 increase; 0 no data). */
+export function analyzeRadar(images: { name: string; vv: Grid; vh: Grid; scale?: 'db' | 'linear' }[], mask: Uint8Array | null, size = 5, enl = ENL_IW_GRD, thresholdDb = 3): RadarResult {
+  const { width: w, height: h } = images[0].vv;
+  const filtered = images.map(im => {
+    const scale = im.scale ?? detectScale(im.vv);
+    const lin = [toLinear(im.vv, scale), toLinear(im.vh, scale)];
+    if (mask) for (const a of lin) for (let k = 0; k < a.length; k++) if (!mask[k]) a[k] = NaN;
+    return { name: im.name, scale, vv: leeFilter(lin[0], w, h, size, enl), vh: leeFilter(lin[1], w, h, size, enl) };
+  });
+  const dates: RadarDate[] = filtered.map(f => {
+    const vv: number[] = [], vh: number[] = [], ratio: number[] = [], rvi: number[] = [];
+    for (let k = 0; k < f.vv.length; k++) {
+      const a = f.vv[k], b = f.vh[k];
+      if (!(Number.isFinite(a) && Number.isFinite(b))) continue;
+      vv.push(db(a));
+      vh.push(db(b));
+      ratio.push(db(b / a));
+      rvi.push((4 * b) / (a + b));
+    }
+    return { name: f.name, scale: f.scale, vv: quartiles(vv), vh: quartiles(vh), ratio: quartiles(ratio), rvi: quartiles(rvi) };
+  });
+  const last = filtered[filtered.length - 1];
+  const vvDb = Float32Array.from(last.vv, db), vhDb = Float32Array.from(last.vh, db);
+  let change: RadarResult['change'] = null;
+  if (filtered.length === 2) {
+    const classes = new Uint8Array(w * h);
+    const counts: [number, number, number] = [0, 0, 0];
+    const lr: number[] = [];
+    for (let k = 0; k < classes.length; k++) {
+      const d = db(filtered[1].vh[k] / filtered[0].vh[k]);
+      if (!Number.isFinite(d)) continue;
+      lr.push(d);
+      const c = d <= -thresholdDb ? 1 : d >= thresholdDb ? 3 : 2;
+      classes[k] = c;
+      counts[c - 1]++;
+    }
+    change = { classes, counts, logRatio: quartiles(lr) };
+  }
+  return { width: w, height: h, dates, vvDb, vhDb, change, size, enl, thresholdDb };
+}
+
+/** Sentinel-1 false colour: R = VV (−25…0 dB), G = VH (−30…−5 dB), B = VV/VH (0…15 dB). */
+export function compositeRgba(r: RadarResult): Uint8ClampedArray {
+  const out = new Uint8ClampedArray(r.width * r.height * 4);
+  const s = (v: number, lo: number, hi: number) => ((v - lo) / (hi - lo)) * 255;
+  for (let k = 0; k < r.vvDb.length; k++) {
+    const a = r.vvDb[k], b = r.vhDb[k];
+    if (!(Number.isFinite(a) && Number.isFinite(b))) continue;
+    out.set([s(a, -25, 0), s(b, -30, -5), s(a - b, 0, 15), 255], k * 4);
+  }
+  return out;
+}
+
+export function changeRgba(classes: Uint8Array): Uint8ClampedArray {
+  const out = new Uint8ClampedArray(classes.length * 4);
+  for (let k = 0; k < classes.length; k++) {
+    const c = classes[k];
+    if (c === 1 || c === 3) out.set([...CHANGE_CLASSES[c - 1].color, 220], k * 4);
+  }
+  return out;
+}
+
+export function radarMarkdown(r: RadarResult, areas: [number, number, number] | null, notes: string[]): string {
+  const q = (s: Quartiles | null) => (s ? `${fmt(s.median, 3)} (${fmt(s.q1, 3)} to ${fmt(s.q3, 3)})` : '—');
+  const lines = ['## Dataset', '', ...r.dates.map((d, i) => `- Image ${i + 1}: ${d.name}`), '', '## Results', '', '| Image | VV dB | VH dB | VH/VV dB | RVI |', '|---|---|---|---|---|'];
+  for (const d of r.dates) lines.push(`| ${d.name} | ${q(d.vv)} | ${q(d.vh)} | ${q(d.ratio)} | ${q(d.rvi)} |`);
+  lines.push('', 'Values are medians (quartiles) over the area.');
+  if (r.change) {
+    const valid = r.change.counts.reduce((a, b) => a + b, 0) || 1;
+    lines.push('', '### Change (VH log ratio)', '', '| Class | Area | Share |', '|---|---|---|');
+    CHANGE_CLASSES.forEach((c, i) => lines.push(`| ${c.label} | ${areas ? `${fmt(areas[i], 4)} ha` : `${r.change!.counts[i].toLocaleString()} px`} | ${((r.change!.counts[i] / valid) * 100).toFixed(1)} % |`));
+    if (r.change.logRatio) lines.push('', `Median log ratio ${fmt(r.change.logRatio.median, 3)} dB (quartiles ${fmt(r.change.logRatio.q1, 3)} to ${fmt(r.change.logRatio.q3, 3)}).`);
+  }
+  lines.push('', '## Method and limits', '', ...notes.map(n => `- ${n}`));
+  return lines.join('\n');
+}
