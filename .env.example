# Copy to .env (docker compose reads it). Never commit real keys.

# Optional: Gemini AI for the assistants and report interpretation. The key
# stays on the server. Without it, the built-in assistant answers and every
# statistic is still computed; users can also add their own key in Settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Delete uploads and results after this many hours (0 keeps them).
TERRAX_RETENTION_HOURS=72
# Largest upload in MB (also raise client_max_body_size in frontend/nginx.conf).
TERRAX_MAX_UPLOAD_MB=500
# Port the web app is published on.
TERRAX_PORT=8080

# Heavy rasters. Forest loss, satellite indices, series and land cover run at
# full resolution up to TERRAX_MAX_PIXELS (larger files are resampled to it),
# in strips on TERRAX_TILE_THREADS cores per job. Memory per job is roughly
# 10 bytes per pixel (about 1 GB at 100 MP) plus the strips in flight.
TERRAX_MAX_PIXELS=100000000
TERRAX_TILE_THREADS=4
# Jobs that run at the same time per worker container (each uses the threads above).
TERRAX_WORKER_CONCURRENCY=2
# Stop a job after this many minutes.
TERRAX_JOB_MINUTES=60
# Replace a worker process after a job leaves it above this many MB (0 = never).
TERRAX_WORKER_MAX_MEMORY_MB=4000
# Terrain and hydrology: DEM budget (flow routing needs about 100 bytes per pixel).
TERRAX_DEM_PIXELS=25000000
# Contours and previews keep the whole grid in memory; their own budget.
TERRAX_GRID_PIXELS=4000000
