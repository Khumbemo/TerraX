# Copy to .env.local and fill in. Never commit real keys.

# GEMINI_API_KEY (optional): enables AI interpretation through the TerraX
# server. The key stays on the server and is never sent to the browser.
# Without it, TerraX still computes all statistics, and each user can add
# their own key in Settings.
GEMINI_API_KEY=""

# PORT (optional): port for `npm start` (default 3001).
PORT=3001
