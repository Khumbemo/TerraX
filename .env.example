# Copy to .env (docker compose reads it). Never commit real keys.

# Optional: Gemini AI for the assistants and report interpretation. The key
# stays on the server. Without it, the built-in assistant answers and every
# statistic is still computed; users can also add their own key in Settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Delete uploads and results after this many hours (0 keeps them).
TERRAX_RETENTION_HOURS=72
# Largest upload in MB (also raise client_max_body_size in frontend/nginx.conf).
TERRAX_MAX_UPLOAD_MB=500
# Port the web app is published on.
TERRAX_PORT=8080
