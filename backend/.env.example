# Copy to backend/.env (docker-compose reads it) or export in your shell.
REDIS_URL=redis://localhost:6379/0
# Optional: AI answers from Gemini (the built-in assistant is used without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Run jobs in the API process (no Redis/Celery needed); handy for quick local use.
TERRAX_EAGER=false
# Without Redis: run jobs on N background threads of the API (one-container hosting), and serve the built web app from the API.
# TERRAX_JOB_THREADS=2
# TERRAX_STATIC=../frontend/dist
TERRAX_CORS=http://localhost:5173,http://127.0.0.1:5173
TERRAX_MAX_UPLOAD_MB=500
TERRAX_RETENTION_HOURS=72

# ── Accounts and access ──
# off: no accounts (each browser sees only its own uploads and results); optional: guests, or sign in to keep
# history and projects; required: everyone signs in (use this on a public server).
TERRAX_AUTH=optional
# open: anyone can create an account; closed: only an admin (admin panel or `python -m terrax.manage create-user`).
TERRAX_SIGNUP=open
# The first administrator, created (or reset to this password) at start-up.
# TERRAX_ADMIN_EMAIL=you@example.org
# TERRAX_ADMIN_PASSWORD=a long passphrase
# Guests' uploads/results are kept TERRAX_RETENTION_HOURS (above); accounts' this many days (0 = until deleted).
TERRAX_USER_RETENTION_DAYS=30
TERRAX_SESSION_DAYS=30
# Database: empty = SQLite in the storage folder. PostgreSQL for several machines (pip install 'terrax[postgres]'):
# DATABASE_URL=postgresql+psycopg://terrax:password@localhost:5432/terrax
# docker-compose.yml runs PostgreSQL itself; set its password here:
# POSTGRES_PASSWORD=change-me
# Proxies in front of the API whose X-Forwarded-For to trust (docker-compose: 1, nginx).
TERRAX_TRUSTED_PROXIES=0
# auto: Secure cookies when the request came over HTTPS. lax/none: none for an app shown in another site's frame.
TERRAX_COOKIE_SECURE=auto
# TERRAX_COOKIE_SAMESITE=lax

# ── Object storage: uploads and results in an S3-compatible bucket ──
# AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi, … (pip install 'terrax[s3]'; the Docker images include it).
# The storage folder becomes a cache: what is not on this disk is fetched from the bucket when it is needed.
# TERRAX_S3_BUCKET=terrax-data
# TERRAX_S3_PREFIX=terrax/
# Another service than AWS (R2: https://<account>.r2.cloudflarestorage.com with region auto; MinIO: http://minio:9000).
# TERRAX_S3_ENDPOINT=
# TERRAX_S3_REGION=
# TERRAX_S3_PATH_STYLE=false
# Credentials: the usual AWS variables (or an instance role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Drop local copies unused for this many hours (the bucket keeps them until they expire).
# TERRAX_S3_CACHE_HOURS=24

# ── Database backups ──
# Every this many hours (0: only `python -m terrax.manage backup`), keeping the newest TERRAX_BACKUP_KEEP.
# They go to <prefix>backups/ in the bucket, else to TERRAX_BACKUP_DIR (default storage/backups: put it on another disk).
TERRAX_BACKUP_HOURS=24
TERRAX_BACKUP_KEEP=14
# TERRAX_BACKUP_DIR=/mnt/backups
# Restore the newest backup into a database that starts empty (SQLite on a disk that does not survive a restart).
# TERRAX_BACKUP_RESTORE_EMPTY=false

# ── E-mail: password-reset links and address confirmation ──
# Links in the messages point at TERRAX_PUBLIC_URL (required for mail), never at a request's Host header.
# TERRAX_PUBLIC_URL=https://terrax.example.org
# TERRAX_SMTP_HOST=smtp.example.org
# TERRAX_SMTP_PORT=587
# TERRAX_SMTP_SECURITY=starttls
# TERRAX_SMTP_USER=
# TERRAX_SMTP_PASSWORD=
# TERRAX_SMTP_FROM=terrax@example.org
# Accounts must confirm their address before working (needs the mail settings above).
# TERRAX_VERIFY_EMAIL=false

# ── Single sign-on (OpenID Connect) ──
# Register TERRAX_PUBLIC_URL/api/auth/oidc/callback as the redirect URI at the provider.
# TERRAX_OIDC_ISSUER=https://accounts.google.com
# TERRAX_OIDC_CLIENT_ID=
# TERRAX_OIDC_CLIENT_SECRET=
# TERRAX_OIDC_NAME=Google
# TERRAX_OIDC_CREATE_ACCOUNTS=true
# TERRAX_OIDC_DOMAINS=example.org

# ── Security ──
# Signs links to result pictures and tiles (they load without cookies). Empty: a random key in the storage folder;
# set one when several machines serve the API without sharing that folder (e.g. openssl rand -hex 32).
# TERRAX_SECRET_KEY=
# TERRAX_MEDIA_URL_HOURS=12
# Largest request body other than an upload, MB.
TERRAX_MAX_BODY_MB=32
TERRAX_AUDIT_RETENTION_DAYS=365

# ── Limits ──
TERRAX_RATE_LIMITS=true
# Where the counters live: auto (Redis with Celery, else the database), redis, database or memory (this process only).
TERRAX_RATE_LIMIT_STORE=auto
TERRAX_JOBS_PER_MINUTE=30
TERRAX_UPLOADS_PER_HOUR=300
TERRAX_USER_QUOTA_MB=10000
TERRAX_GUEST_QUOTA_MB=2000

# ── Monitoring ──
# text or json (one JSON object per line, with the request ID).
TERRAX_LOG_FORMAT=text
TERRAX_LOG_LEVEL=INFO
# Prometheus scrapes /api/metrics with this bearer token (admins can always read it).
# TERRAX_METRICS_TOKEN=
# Error tracking with Sentry or GlitchTip (pip install 'terrax[sentry]'):
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
TERRAX_ERROR_RETENTION_DAYS=30
