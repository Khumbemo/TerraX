# Copy to backend/.env (docker-compose reads it) or export in your shell.
REDIS_URL=redis://localhost:6379/0
# Optional: AI answers from Gemini (the built-in assistant is used without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Run jobs in the API process (no Redis/Celery needed); handy for quick local use.
TERRAX_EAGER=false
# Without Redis: run jobs on N background threads of the API (one-container hosting), and serve the built web app from the API.
# TERRAX_JOB_THREADS=2
# TERRAX_STATIC=../frontend/dist
TERRAX_CORS=http://localhost:5173,http://127.0.0.1:5173
TERRAX_MAX_UPLOAD_MB=500
TERRAX_RETENTION_HOURS=72

# ── Accounts and access ──
# off: no accounts (each browser sees only its own uploads and results); optional: guests, or sign in to keep
# history and projects; required: everyone signs in (use this on a public server).
TERRAX_AUTH=optional
# open: anyone can create an account; closed: only an admin (admin panel or `python -m terrax.manage create-user`).
TERRAX_SIGNUP=open
# The first administrator, created (or reset to this password) at start-up.
# TERRAX_ADMIN_EMAIL=you@example.org
# TERRAX_ADMIN_PASSWORD=a long passphrase
# Guests' uploads/results are kept TERRAX_RETENTION_HOURS (above); accounts' this many days (0 = until deleted).
TERRAX_USER_RETENTION_DAYS=30
TERRAX_SESSION_DAYS=30
# Database: empty = SQLite in the storage folder. PostgreSQL for several machines (pip install 'terrax[postgres]'):
# DATABASE_URL=postgresql+psycopg://terrax:password@localhost:5432/terrax
# docker-compose.yml runs PostgreSQL itself; set its password here:
# POSTGRES_PASSWORD=change-me
# Proxies in front of the API whose X-Forwarded-For to trust (docker-compose: 1, nginx).
TERRAX_TRUSTED_PROXIES=0
# auto: Secure cookies when the request came over HTTPS. lax/none: none for an app shown in another site's frame.
TERRAX_COOKIE_SECURE=auto
# TERRAX_COOKIE_SAMESITE=lax

# ── Limits ──
TERRAX_RATE_LIMITS=true
TERRAX_JOBS_PER_MINUTE=30
TERRAX_UPLOADS_PER_HOUR=300
TERRAX_USER_QUOTA_MB=10000
TERRAX_GUEST_QUOTA_MB=2000

# ── Monitoring ──
# text or json (one JSON object per line, with the request ID).
TERRAX_LOG_FORMAT=text
TERRAX_LOG_LEVEL=INFO
# Prometheus scrapes /api/metrics with this bearer token (admins can always read it).
# TERRAX_METRICS_TOKEN=
# Error tracking with Sentry or GlitchTip (pip install 'terrax[sentry]'):
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
TERRAX_ERROR_RETENTION_DAYS=30
