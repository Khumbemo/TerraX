# Cache rules for Netlify and Cloudflare Pages (GitHub Pages ignores this file).
# Built files have content hashes in their names, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Map files keep their names between releases: cache for a week, then revalidate.
/data/maps/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# The service worker and page must be checked on every visit so updates arrive.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
